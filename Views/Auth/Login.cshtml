@model PayroTech.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - PayroTech</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --accent:#0891b2; --accent-dark:#0e7490; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; min-height:100vh; display:flex; background:#f1f5f9; }
        .left-panel {
            flex:1; background:linear-gradient(145deg,#0f172a 0%,#1e3a5f 50%,#0891b2 100%);
            display:flex; flex-direction:column; justify-content:center; align-items:center;
            padding:60px 48px; color:#fff; position:relative; overflow:hidden;
        }
        .left-panel::before {
            content:""; position:absolute; inset:0;
            background:radial-gradient(circle at 30% 50%,rgba(34,211,238,.18) 0%,transparent 60%),
                        radial-gradient(circle at 80% 20%,rgba(8,145,178,.15) 0%,transparent 50%);
        }
        .left-content { position:relative; z-index:1; max-width:420px; }
        .brand { display:flex; align-items:center; gap:12px; margin-bottom:48px; }
        .brand-icon { width:52px; height:52px; background:rgba(255,255,255,.15); border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:1.6rem; }
        .brand-name { font-size:1.6rem; font-weight:700; letter-spacing:-.5px; }
        .brand-tag  { font-size:.75rem; opacity:.7; margin-top:1px; }
        .left-panel h2 { font-size:2.2rem; font-weight:700; line-height:1.25; margin-bottom:16px; }
        .left-panel p  { font-size:1rem; opacity:.8; line-height:1.7; margin-bottom:40px; }
        .feature-list { list-style:none; display:flex; flex-direction:column; gap:14px; }
        .feature-list li { display:flex; align-items:center; gap:12px; font-size:.9rem; opacity:.9; }
        .feature-list li i { width:32px; height:32px; background:rgba(255,255,255,.12); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; }
        .right-panel { width:480px; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:48px 40px; background:#fff; }
        .login-box { width:100%; max-width:380px; }
        .login-box h3 { font-size:1.6rem; font-weight:700; color:#0f172a; margin-bottom:6px; }
        .login-box .sub { font-size:.9rem; color:#64748b; margin-bottom:32px; }
        .form-label { font-size:.85rem; font-weight:600; color:#374151; margin-bottom:6px; }
        .input-wrap { position:relative; }
        .input-wrap .icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:1rem; pointer-events:none; }
        .input-wrap input { width:100%; padding:11px 14px 11px 40px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:.9rem; transition:border-color .2s,box-shadow .2s; outline:none; font-family:inherit; }
        .input-wrap input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(8,145,178,.12); }
        .input-wrap .eye { position:absolute; right:14px; top:50%; transform:translateY(-50%); color:#94a3b8; cursor:pointer; font-size:1rem; }
        .btn-signin { width:100%; padding:12px; background:linear-gradient(135deg,var(--accent),var(--accent-dark)); color:#fff; border:none; border-radius:10px; font-size:.95rem; font-weight:600; cursor:pointer; transition:opacity .2s,transform .2s; margin-top:8px; }
        .btn-signin:hover { opacity:.92; transform:translateY(-1px); }
        .divider { display:flex; align-items:center; gap:12px; margin:24px 0; color:#94a3b8; font-size:.8rem; }
        .divider::before,.divider::after { content:""; flex:1; height:1px; background:#e2e8f0; }
        .register-link { display:block; width:100%; padding:11px; border:1.5px solid #e2e8f0; border-radius:10px; text-align:center; font-size:.9rem; font-weight:600; color:#0f172a; text-decoration:none; transition:border-color .2s,background .2s; }
        .register-link:hover { border-color:var(--accent); background:#f0f9ff; color:var(--accent); }
        .alert-err { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; border-radius:10px; padding:12px 16px; font-size:.85rem; margin-bottom:20px; }
        .remember-row { display:flex; justify-content:space-between; align-items:center; margin:16px 0; }
        .remember-row label { font-size:.85rem; color:#64748b; display:flex; align-items:center; gap:6px; cursor:pointer; }
        .footer-note { text-align:center; margin-top:32px; font-size:.78rem; color:#94a3b8; }
        @@media (max-width:900px) { .left-panel { display:none; } .right-panel { width:100%; padding:40px 24px; } }
    </style>
</head>
<body>
    <div class="left-panel">
        <div class="left-content">
            <div class="brand">
                <div class="brand-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div><div class="brand-name">PayroTech</div><div class="brand-tag">Payroll & HR Management</div></div>
            </div>
            <h2>Smart Payroll for Philippine Businesses</h2>
            <p>Automate attendance tracking, payroll computation, and government compliance — all in one platform.</p>
            <ul class="feature-list">
                <li><i class="bi bi-clock-history"></i> Kiosk-based attendance with QR + PIN</li>
                <li><i class="bi bi-cash-stack"></i> Automated payroll with SSS, PhilHealth, Pag-IBIG</li>
                <li><i class="bi bi-calendar-check"></i> Leave management & overtime tracking</li>
                <li><i class="bi bi-shield-check"></i> Role-based access for all staff levels</li>
            </ul>
        </div>
    </div>
    <div class="right-panel">
        <div class="login-box">
            <h3>Welcome back</h3>
            <p class="sub">Sign in to your PayroTech account</p>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-err">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span>@error.ErrorMessage</span>
                    }
                </div>
            }
            <form method="post" asp-action="Login">
                <div class="mb-4">
                    <label class="form-label">Email Address</label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope icon"></i>
                        <input type="email" asp-for="Email" placeholder="you@company.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem;"></span>
                </div>
                <div class="mb-2">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock icon"></i>
                        <input type="password" asp-for="Password" id="pwInput" placeholder="Enter your password" autocomplete="current-password" />
                        <i class="bi bi-eye eye" id="eyeIcon" onclick="togglePw()"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem;"></span>
                </div>
                <div class="remember-row">
                    <label><input type="checkbox" asp-for="RememberMe" style="accent-color:var(--accent);"> Remember me</label>
                </div>

                <!-- reCAPTCHA v2 — must be completed before sign in -->
                <div class="mb-3">
                    <div class="g-recaptcha" data-sitekey="@ViewBag.RecaptchaSiteKey"
                         data-callback="onRecaptchaSuccess"
                         data-expired-callback="onRecaptchaExpired"></div>
                    <div id="recaptcha-error" style="display:none;color:#dc2626;font-size:.8rem;margin-top:4px;">
                        <i class="bi bi-exclamation-circle me-1"></i>Please complete the reCAPTCHA verification.
                    </div>
                </div>

                <button type="submit" class="btn-signin" id="signinBtn" disabled>
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>
            <div class="divider">or</div>
            <a href="/Register" class="register-link">
                <i class="bi bi-building-add me-2"></i>Register Your Company Online
            </a>
            <div class="footer-note">
                &copy; 2026 PayroTech &nbsp;&middot;&nbsp;
                <a href="/" style="color:#94a3b8;text-decoration:none;">Back to Home</a>
                &nbsp;&middot;&nbsp;
                <a href="/Kiosk" style="color:#94a3b8;text-decoration:none;">Kiosk Mode</a>
            </div>
        </div>
    </div>
    <script>
        function togglePw() {
            const i = document.getElementById("pwInput");
            const e = document.getElementById("eyeIcon");
            if (i.type === "password") { i.type = "text"; e.className = "bi bi-eye-slash eye"; }
            else { i.type = "password"; e.className = "bi bi-eye eye"; }
        }
        if (window.history.replaceState) window.history.replaceState(null, null, window.location.href);

        // reCAPTCHA callbacks
        function onRecaptchaSuccess(token) {
            document.getElementById('signinBtn').disabled = false;
            document.getElementById('recaptcha-error').style.display = 'none';
        }
        function onRecaptchaExpired() {
            document.getElementById('signinBtn').disabled = true;
        }

        // Extra guard: validate reCAPTCHA on form submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const response = grecaptcha.getResponse();
            if (!response) {
                e.preventDefault();
                document.getElementById('recaptcha-error').style.display = 'block';
                document.getElementById('signinBtn').disabled = true;
            }
        });
    </script>
    <!-- Google reCAPTCHA v2 -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</body>
</html>
