@{
    ViewData["Title"] = "Payroll Approval";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Payroll Approval</h4>
        <p class="text-muted mb-0">Review and approve payroll submissions from HR</p>
    </div>
    <div class="d-flex gap-2">
        <button class="pt-btn pt-btn-ghost">
            <i class="bi bi-clock-history me-2"></i>History
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="pt-stats-card warning">
            <div class="pt-stats-value">3</div>
            <div class="pt-stats-label">Pending Approval</div>
            <i class="bi bi-hourglass-split pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card success">
            <div class="pt-stats-value">8</div>
            <div class="pt-stats-label">Approved This Month</div>
            <i class="bi bi-check-circle pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card danger">
            <div class="pt-stats-value">1</div>
            <div class="pt-stats-label">Late Submissions</div>
            <i class="bi bi-exclamation-triangle pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card">
            <div class="pt-stats-value">₱1.5M</div>
            <div class="pt-stats-label">Pending Amount</div>
            <i class="bi bi-cash-stack pt-stats-icon"></i>
        </div>
    </div>
</div>

<!-- Pending Approvals -->
<div class="row">
    <div class="col-12">
        <div class="pt-card mb-4">
            <div class="pt-card-header">
                <i class="bi bi-hourglass-split text-warning me-2"></i>Pending Approvals
            </div>
            <div class="pt-card-body p-0">
                <!-- Pending Item 1 -->
                <div class="p-4 border-bottom">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="pt-avatar" style="background: linear-gradient(135deg, #0891b2, #22d3ee); width: 50px; height: 50px;">E</div>
                                <div>
                                    <h5 class="mb-1">Engineering Team - March 2026 (2nd Half)</h5>
                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="bi bi-person me-1"></i>Submitted by Maria Santos</span>
                                        <span><i class="bi bi-calendar me-1"></i>Mar 28, 2026</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="row">
                                <div class="col-6">
                                    <div class="text-muted small">Employees</div>
                                    <div class="fw-bold">24</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Total</div>
                                    <div class="fw-bold text-primary">₱450,000</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-end">
                            <span class="pt-badge pt-badge-warning mb-2 d-inline-block">Pending Review</span>
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="pt-btn pt-btn-ghost pt-btn-sm" data-bs-toggle="modal" data-bs-target="#viewPayrollModal">
                                    <i class="bi bi-eye me-1"></i>View
                                </button>
                                <button class="pt-btn pt-btn-success pt-btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Approve
                                </button>
                                <button class="pt-btn pt-btn-danger pt-btn-sm">
                                    <i class="bi bi-x-lg me-1"></i>Reject
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending Item 2 -->
                <div class="p-4 border-bottom">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="pt-avatar" style="background: linear-gradient(135deg, #059669, #34d399); width: 50px; height: 50px;">S</div>
                                <div>
                                    <h5 class="mb-1">Sales Team - March 2026 (2nd Half)</h5>
                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="bi bi-person me-1"></i>Submitted by Juan Dela Cruz</span>
                                        <span><i class="bi bi-calendar me-1"></i>Mar 28, 2026</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="row">
                                <div class="col-6">
                                    <div class="text-muted small">Employees</div>
                                    <div class="fw-bold">18</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Total</div>
                                    <div class="fw-bold text-primary">₱380,000</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-end">
                            <span class="pt-badge pt-badge-warning mb-2 d-inline-block">Pending Review</span>
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="pt-btn pt-btn-ghost pt-btn-sm">
                                    <i class="bi bi-eye me-1"></i>View
                                </button>
                                <button class="pt-btn pt-btn-success pt-btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Approve
                                </button>
                                <button class="pt-btn pt-btn-danger pt-btn-sm">
                                    <i class="bi bi-x-lg me-1"></i>Reject
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending Item 3 (Late) -->
                <div class="p-4" style="background: rgba(239, 68, 68, 0.05);">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="pt-avatar" style="background: linear-gradient(135deg, #7c3aed, #a855f7); width: 50px; height: 50px;">O</div>
                                <div>
                                    <h5 class="mb-1">
                                        Operations Team - March 2026 (2nd Half)
                                        <span class="pt-badge pt-badge-danger ms-2">LATE</span>
                                    </h5>
                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="bi bi-person me-1"></i>Submitted by Ana Reyes</span>
                                        <span class="text-danger"><i class="bi bi-calendar me-1"></i>Mar 29, 2026 (2 days late)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="row">
                                <div class="col-6">
                                    <div class="text-muted small">Employees</div>
                                    <div class="fw-bold">32</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Total</div>
                                    <div class="fw-bold text-primary">₱520,000</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-end">
                            <span class="pt-badge pt-badge-danger mb-2 d-inline-block">Late Submission</span>
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="pt-btn pt-btn-ghost pt-btn-sm">
                                    <i class="bi bi-eye me-1"></i>View
                                </button>
                                <button class="pt-btn pt-btn-warning pt-btn-sm">
                                    <i class="bi bi-exclamation-triangle me-1"></i>View Incident
                                </button>
                                <button class="pt-btn pt-btn-success pt-btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Approve
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recently Approved -->
<div class="row">
    <div class="col-12">
        <div class="pt-table-wrapper">
            <div class="pt-card-header">
                <i class="bi bi-check-circle text-success me-2"></i>Recently Approved
            </div>
            <table class="pt-table">
                <thead>
                    <tr>
                        <th>Team</th>
                        <th>Period</th>
                        <th>Submitted By</th>
                        <th>Employees</th>
                        <th>Total Amount</th>
                        <th>Approved Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="pt-avatar pt-avatar-sm" style="background: linear-gradient(135deg, #f59e0b, #fbbf24);">H</div>
                                HR & Admin
                            </div>
                        </td>
                        <td>March 2026 (2nd Half)</td>
                        <td>Pedro Garcia</td>
                        <td>12</td>
                        <td class="fw-semibold">₱195,000</td>
                        <td>Mar 27, 2026</td>
                        <td><span class="pt-badge pt-badge-success">Approved</span></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="pt-avatar pt-avatar-sm" style="background: linear-gradient(135deg, #0891b2, #22d3ee);">E</div>
                                Engineering
                            </div>
                        </td>
                        <td>March 2026 (1st Half)</td>
                        <td>Maria Santos</td>
                        <td>24</td>
                        <td class="fw-semibold">₱445,000</td>
                        <td>Mar 13, 2026</td>
                        <td><span class="pt-badge pt-badge-success">Approved</span></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="pt-avatar pt-avatar-sm" style="background: linear-gradient(135deg, #059669, #34d399);">S</div>
                                Sales
                            </div>
                        </td>
                        <td>March 2026 (1st Half)</td>
                        <td>Juan Dela Cruz</td>
                        <td>18</td>
                        <td class="fw-semibold">₱375,000</td>
                        <td>Mar 13, 2026</td>
                        <td><span class="pt-badge pt-badge-success">Approved</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- View Payroll Modal -->
<div class="modal fade" id="viewPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i>Payroll Details - Engineering Team</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Team:</strong> Engineering Team</p>
                        <p class="mb-1"><strong>Period:</strong> March 2026 (2nd Half)</p>
                        <p class="mb-1"><strong>Submitted By:</strong> Maria Santos</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-1"><strong>Submission Date:</strong> Mar 28, 2026</p>
                        <p class="mb-1"><strong>Total Employees:</strong> 24</p>
                        <p class="mb-1"><strong>Total Amount:</strong> <span class="text-primary fw-bold">₱450,000</span></p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Basic Pay</th>
                                <th>OT Pay</th>
                                <th>Deductions</th>
                                <th>Net Pay</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Juan Rodriguez</td>
                                <td>₱25,000</td>
                                <td>₱3,000</td>
                                <td class="text-danger">-₱2,500</td>
                                <td class="fw-bold">₱25,500</td>
                            </tr>
                            <tr>
                                <td>Maria Santos</td>
                                <td>₱28,000</td>
                                <td>₱1,500</td>
                                <td class="text-danger">-₱2,800</td>
                                <td class="fw-bold">₱26,700</td>
                            </tr>
                            <tr>
                                <td>Pedro Garcia</td>
                                <td>₱22,000</td>
                                <td>₱2,200</td>
                                <td class="text-danger">-₱2,200</td>
                                <td class="fw-bold">₱22,000</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-muted">... and 21 more employees</td>
                                <td></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>TOTAL</td>
                                <td>₱400,000</td>
                                <td>₱80,000</td>
                                <td class="text-danger">-₱30,000</td>
                                <td class="text-primary">₱450,000</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="pt-btn pt-btn-ghost" data-bs-dismiss="modal">Close</button>
                <button type="button" class="pt-btn pt-btn-danger">
                    <i class="bi bi-x-lg me-1"></i>Reject
                </button>
                <button type="button" class="pt-btn pt-btn-success">
                    <i class="bi bi-check-lg me-1"></i>Approve Payroll
                </button>
            </div>
        </div>
    </div>
</div>
