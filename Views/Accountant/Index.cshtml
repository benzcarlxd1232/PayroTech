@{
    ViewData["Title"] = "Accountant Dashboard";
    Layout = "~/Views/Shared/_AccountantLayout.cshtml";

    var pendingPayrolls = ViewBag.PendingPayrolls as List<PayroTech.Models.Entities.Payroll> ?? new();
    var user            = ViewBag.CurrentUser     as PayroTech.Models.Entities.ApplicationUser;
    var todayAtt        = ViewBag.TodayAtt        as PayroTech.Models.Entities.Attendance;
    int pendingCount    = ViewBag.PendingCount    ?? 0;
    decimal pendingTotal = ViewBag.PendingTotal   ?? 0m;
    decimal monthTotal  = ViewBag.MonthTotal      ?? 0m;
    int monthEmployees  = ViewBag.MonthEmployees  ?? 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Pending Distribution Banner -->
@if (pendingCount > 0)
{
    <div class="card shadow-sm mb-4" style="background:linear-gradient(135deg,#ea8a1a,#f59e0b);color:#fff;">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="mb-1"><i class="bi bi-cash-coin me-2"></i>Pending Payroll Distribution</h5>
                    <div class="fs-4 fw-bold">₱@pendingTotal.ToString("N2")</div>
                    <p class="mb-0 opacity-75 small">@pendingCount payroll record(s) awaiting distribution</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/Accountant/PendingPayrolls" class="btn btn-light fw-semibold">
                        <i class="bi bi-send me-2"></i>View & Distribute
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-warning">@pendingCount</div>
            <div class="text-muted small">Pending Distribution</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center py-3">
            <div class="fs-4 fw-bold text-success">₱@monthTotal.ToString("N0")</div>
            <div class="text-muted small">Paid This Month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-primary">@monthEmployees</div>
            <div class="text-muted small">Employees Paid</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center py-3">
            @if (todayAtt?.TimeIn != null)
            {
                <div class="fs-5 fw-bold text-success">@todayAtt.TimeIn.Value.ToString("hh:mm tt")</div>
                <div class="text-muted small">My Time In</div>
            }
            else
            {
                <div class="fs-5 fw-bold text-muted">—</div>
                <div class="text-muted small">Not Clocked In</div>
            }
        </div>
    </div>
</div>

<!-- Pending Payrolls Table -->
<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-hourglass-split me-2"></i>Approved Payrolls — Ready for Distribution</span>
        <a href="/Accountant/PendingPayrolls" class="btn btn-sm btn-outline-warning">View All</a>
    </div>
    @if (!pendingPayrolls.Any())
    {
        <div class="card-body text-center py-4">
            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
            <h6>No pending distributions</h6>
            <p class="text-muted small">All payrolls have been distributed.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Department</th>
                        <th>Period</th>
                        <th class="text-end">Gross Pay</th>
                        <th class="text-end">Net Pay</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pendingPayrolls.Take(8))
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@p.Employee?.FullName</td>
                            <td class="text-muted small">@(p.Employee?.Department?.DepartmentName ?? "—")</td>
                            <td class="text-muted small">@(p.PayrollPeriod?.PeriodName ?? "—")</td>
                            <td class="text-end">₱@p.GrossPay.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">₱@p.NetPay.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-warning text-dark">@p.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Quick Actions -->
<div class="card shadow-sm">
    <div class="card-header fw-semibold"><i class="bi bi-lightning me-2"></i>Quick Actions</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <a href="/Accountant/ProcessPayroll" class="btn btn-primary w-100">
                    <i class="bi bi-calculator me-2"></i>Process Payroll
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Accountant/DistributeSalaries" class="btn btn-warning w-100">
                    <i class="bi bi-send me-2"></i>Distribute Salaries
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Accountant/Payslips" class="btn btn-outline-primary w-100">
                    <i class="bi bi-file-earmark-text me-2"></i>Payslips
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Accountant/Reports" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-graph-up me-2"></i>Reports
                </a>
            </div>
        </div>
    </div>
</div>
