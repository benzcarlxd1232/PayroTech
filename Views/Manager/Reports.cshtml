@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var currentMonth = DateTime.Now.Month;
    var currentYear = DateTime.Now.Year;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Reports & Analytics</h4>
        <p class="text-muted mb-0">Generate and download password-protected PDF reports</p>
    </div>
    <div class="d-flex gap-2">
        <select id="reportMonth" class="form-select form-select-sm" style="width:auto;">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
            }
        </select>
        <select id="reportYear" class="form-select form-select-sm" style="width:auto;">
            @for (int y = currentYear; y >= currentYear - 2; y--)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
</div>

<!-- Report Categories -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="pt-card h-100">
            <div class="pt-card-header">
                <i class="bi bi-cash-stack text-success me-2"></i>Payroll Reports
            </div>
            <div class="pt-card-body p-0">
                <a href="#" class="report-item d-flex align-items-center p-3 border-bottom text-decoration-none"
                   onclick="downloadReport('/ReportDownload/ManagerPayrollSummary', 'PayrollSummary', true); return false;">
                    <div class="report-icon me-3" style="background: #dcfce7; color: #059669;">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Payroll Summary</strong>
                        <div class="small text-muted">Monthly payroll breakdown by team</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-download"></i> PDF</span>
                </a>
                <a href="#" class="report-item d-flex align-items-center p-3 border-bottom text-decoration-none"
                   onclick="downloadReport('/ReportDownload/ManagerGovernmentReport', 'GovernmentCompliance', true); return false;">
                    <div class="report-icon me-3" style="background: #dcfce7; color: #059669;">
                        <i class="bi bi-calculator"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Government Contributions</strong>
                        <div class="small text-muted">SSS, PhilHealth, Pag-IBIG, Tax</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-download"></i> PDF</span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="pt-card h-100">
            <div class="pt-card-header">
                <i class="bi bi-people text-info me-2"></i>Employee Reports
            </div>
            <div class="pt-card-body p-0">
                <a href="#" class="report-item d-flex align-items-center p-3 border-bottom text-decoration-none"
                   onclick="downloadReport('/ReportDownload/ManagerEmployeeMasterlist', 'EmployeeMasterlist', false); return false;">
                    <div class="report-icon me-3" style="background: #e0f2fe; color: #0891b2;">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Employee Masterlist</strong>
                        <div class="small text-muted">Complete employee directory</div>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info"><i class="bi bi-download"></i> PDF</span>
                </a>
                <a href="#" class="report-item d-flex align-items-center p-3 text-decoration-none"
                   onclick="downloadReport('/ReportDownload/ManagerAttendanceReport', 'AttendanceReport', true); return false;">
                    <div class="report-icon me-3" style="background: #e0f2fe; color: #0891b2;">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Attendance Report</strong>
                        <div class="small text-muted">Attendance summary by period</div>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info"><i class="bi bi-download"></i> PDF</span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="pt-card h-100">
            <div class="pt-card-header">
                <i class="bi bi-shield-check text-warning me-2"></i>Security & Audit
            </div>
            <div class="pt-card-body p-0">
                <a href="#" class="report-item d-flex align-items-center p-3 text-decoration-none"
                   onclick="downloadAuditReport(); return false;">
                    <div class="report-icon me-3" style="background: #fef3c7; color: #f59e0b;">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Activity Logs</strong>
                        <div class="small text-muted">Full audit trail (last 30 days)</div>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning"><i class="bi bi-download"></i> PDF</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Security Notice -->
<div class="row">
    <div class="col-12">
        <div class="pt-card">
            <div class="pt-card-body">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:48px;height:48px;background:linear-gradient(135deg,#dbeafe,#e0f2fe);">
                        <i class="bi bi-shield-lock-fill text-primary fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Password-Protected Reports</h6>
                        <p class="text-muted mb-0" style="font-size:.85rem;">
                            All downloaded PDF reports are encrypted with <strong>AES-256</strong> using your account password.
                            You will need to enter your password when opening the PDF file. This ensures confidential payroll
                            and employee data remains secure even if the file is shared or intercepted.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PdfDownloadModal")

<style>
    .report-item {
        color: var(--pt-text-primary);
        transition: background 0.2s, transform 0.1s;
    }
    .report-item:hover {
        background: var(--pt-bg-secondary);
        transform: translateX(2px);
    }
    .report-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
</style>

<script>
    function downloadReport(baseUrl, reportName, usePeriod) {
        let url = baseUrl;
        if (usePeriod) {
            const month = document.getElementById('reportMonth').value;
            const year = document.getElementById('reportYear').value;
            url += `?year=${year}&month=${month}`;
        }
        requestPdfDownload(url, reportName);
    }

    function downloadAuditReport() {
        requestPdfDownload('/ReportDownload/ManagerAuditLogReport?days=30', 'AuditLogs');
    }
</script>
