@{
    ViewData["Title"] = "All Employees";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">All Employees</h4>
        <p class="text-muted mb-0">Company-wide employee directory</p>
    </div>
    <div class="d-flex gap-2">
        <button class="pt-btn pt-btn-ghost">
            <i class="bi bi-download me-2"></i>Export
        </button>
        <button class="pt-btn pt-btn-primary">
            <i class="bi bi-person-plus me-2"></i>Add Employee
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="pt-stats-card">
            <div class="pt-stats-value">148</div>
            <div class="pt-stats-label">Total Employees</div>
            <i class="bi bi-people pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card success">
            <div class="pt-stats-value">142</div>
            <div class="pt-stats-label">Active</div>
            <i class="bi bi-check-circle pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card warning">
            <div class="pt-stats-value">4</div>
            <div class="pt-stats-label">On Leave</div>
            <i class="bi bi-calendar-x pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card danger">
            <div class="pt-stats-value">2</div>
            <div class="pt-stats-label">Inactive</div>
            <i class="bi bi-person-x pt-stats-icon"></i>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="row mb-4">
    <div class="col-12">
        <div class="pt-card">
            <div class="pt-card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Search</label>
                        <input type="text" class="form-control" placeholder="Search by name, ID, or email...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Department</label>
                        <select class="form-select">
                            <option>All Departments</option>
                            <option>Engineering</option>
                            <option>Design</option>
                            <option>Marketing</option>
                            <option>Sales</option>
                            <option>Operations</option>
                            <option>Finance</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Status</label>
                        <select class="form-select">
                            <option>All Status</option>
                            <option>Active</option>
                            <option>On Leave</option>
                            <option>Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Employment Type</label>
                        <select class="form-select">
                            <option>All Types</option>
                            <option>Full-time</option>
                            <option>Part-time</option>
                            <option>Contract</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="pt-btn pt-btn-primary me-2">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                        <button class="pt-btn pt-btn-ghost">Clear</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

