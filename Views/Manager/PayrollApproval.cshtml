@{
    ViewData["Title"] = "Payroll Approval";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var pendingPeriods = ViewBag.PendingPeriods as List<PayroTech.Models.Entities.PayrollPeriod> ?? new();
    var historyPeriods = ViewBag.HistoryPeriods as List<PayroTech.Models.Entities.PayrollPeriod> ?? new();
    int pendingCount   = ViewBag.PendingCount ?? 0;
    decimal pendingTotal = ViewBag.PendingTotal ?? 0m;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Payroll Approval</h4>
        <p class="text-muted mb-0">Review and approve payroll submissions from HR</p>
    </div>
</div>

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="pt-stats-card warning">
            <div class="pt-stats-value">@pendingCount</div>
            <div class="pt-stats-label">Pending Approval</div>
            <i class="bi bi-hourglass-split pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pt-stats-card success">
            <div class="pt-stats-value">@historyPeriods.Count</div>
            <div class="pt-stats-label">Approved</div>
            <i class="bi bi-check-circle pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pt-stats-card">
            <div class="pt-stats-value">₱@pendingTotal.ToString("N0")</div>
            <div class="pt-stats-label">Pending Amount</div>
            <i class="bi bi-cash-stack pt-stats-icon"></i>
        </div>
    </div>
</div>

<!-- Pending Approvals -->
<div class="pt-card mb-4">
    <div class="pt-card-header">
        <i class="bi bi-hourglass-split text-warning me-2"></i>
        Pending Approvals
        @if (pendingCount > 0)
        {
            <span class="badge bg-warning text-dark ms-2">@pendingCount</span>
        }
    </div>
    @if (!pendingPeriods.Any())
    {
        <div class="pt-card-body text-center py-5">
            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-3"></i>
            <h6>No pending payrolls</h6>
            <p class="text-muted small">All payroll submissions have been reviewed.</p>
        </div>
    }
    else
    {
        foreach (var period in pendingPeriods)
        {
            var total      = period.Payrolls.Sum(p => p.NetPay);
            var empCount   = period.Payrolls.Select(p => p.EmployeeId).Distinct().Count();
            var deptNames  = period.Payrolls
                .Select(p => p.Employee?.Department?.DepartmentName)
                .Where(d => d != null).Distinct().Take(2).ToList();
            var deptLabel  = deptNames.Any() ? string.Join(", ", deptNames) : "All Teams";

            <div class="p-4 border-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="mb-1">@period.PeriodName</h5>
                        <div class="d-flex gap-3 text-muted small flex-wrap">
                            <span><i class="bi bi-people me-1"></i>@deptLabel</span>
                            <span><i class="bi bi-calendar me-1"></i>@period.StartDate.ToString("MMM dd") – @period.EndDate.ToString("MMM dd, yyyy")</span>
                            <span><i class="bi bi-clock me-1"></i>Pay date: @period.PayDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="row">
                            <div class="col-6">
                                <div class="text-muted small">Employees</div>
                                <div class="fw-bold">@empCount</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Net Total</div>
                                <div class="fw-bold text-primary">₱@total.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 text-end">
                        <span class="pt-badge pt-badge-warning mb-2 d-inline-block">Pending Review</span>
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <button class="pt-btn pt-btn-ghost pt-btn-sm"
                                    onclick="viewPayroll(@period.Id, '@period.PeriodName')">
                                <i class="bi bi-eye me-1"></i>View
                            </button>
                            <button class="pt-btn pt-btn-success pt-btn-sm"
                                    onclick="approvePayroll(@period.Id, '@period.PeriodName', @total)">
                                <i class="bi bi-check-lg me-1"></i>Approve
                            </button>
                            <button class="pt-btn pt-btn-danger pt-btn-sm"
                                    onclick="rejectPayroll(@period.Id, '@period.PeriodName')">
                                <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- History -->
@if (historyPeriods.Any())
{
    <div class="pt-card">
        <div class="pt-card-header">
            <i class="bi bi-check-circle text-success me-2"></i>Approved History
        </div>
        <div class="table-responsive">
            <table class="pt-table">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th class="text-center">Employees</th>
                        <th class="text-end">Net Total</th>
                        <th class="text-center">Approved</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var period in historyPeriods)
                    {
                        <tr>
                            <td class="fw-medium">@period.PeriodName</td>
                            <td class="text-center">@period.Payrolls.Select(p => p.EmployeeId).Distinct().Count()</td>
                            <td class="text-end fw-semibold">₱@period.Payrolls.Sum(p => p.NetPay).ToString("N2")</td>
                            <td class="text-center text-muted small">@(period.ProcessedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td class="text-center">
                                <span class="pt-badge @(period.Status == PayrollStatus.Paid ? "pt-badge-success" : "pt-badge-primary")">
                                    @period.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- View Detail Modal -->
<div class="modal fade" id="viewPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-text me-2"></i><span id="modalPeriodName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalPayrollBody">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="modalApproveBtn">
                    <i class="bi bi-check-lg me-1"></i>Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger"><i class="bi bi-x-circle me-2"></i>Reject Payroll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Rejecting <strong id="rejectPeriodName"></strong> will send it back to HR for correction.</p>
                <label class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                <textarea class="form-control" id="rejectReason" rows="3" placeholder="Explain what needs to be corrected..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtn">
                    <i class="bi bi-x-lg me-1"></i>Confirm Reject
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
               || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];

    // Inline antiforgery for fetch calls
    const csrfToken = '@Html.AntiForgeryToken()';

    async function approvePayroll(periodId, periodName, total) {
        if (!confirm(`Approve "${periodName}"?\nTotal Net Pay: ₱${Number(total).toLocaleString('en-PH', {minimumFractionDigits:2})}\n\nThis will allow the Accountant to distribute salaries.`)) return;

        const fd = new FormData();
        fd.append('periodId', periodId);
        fd.append('__RequestVerificationToken', getToken());

        const r = await fetch('/Manager/ApprovePayroll', { method: 'POST', body: fd });
        const data = await r.json();

        if (data.success) {
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast(data.message, 'error');
        }
    }

    let currentRejectId = null;
    function rejectPayroll(periodId, periodName) {
        currentRejectId = periodId;
        document.getElementById('rejectPeriodName').textContent = periodName;
        document.getElementById('rejectReason').value = '';
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    document.getElementById('confirmRejectBtn').addEventListener('click', async () => {
        const reason = document.getElementById('rejectReason').value.trim();
        if (!reason) { alert('Please provide a reason for rejection.'); return; }

        const fd = new FormData();
        fd.append('periodId', currentRejectId);
        fd.append('reason', reason);
        fd.append('__RequestVerificationToken', getToken());

        const r = await fetch('/Manager/RejectPayroll', { method: 'POST', body: fd });
        const data = await r.json();

        bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
        if (data.success) {
            showToast(data.message, 'warning');
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast(data.message, 'error');
        }
    });

    async function viewPayroll(periodId, periodName) {
        document.getElementById('modalPeriodName').textContent = periodName;
        document.getElementById('modalPayrollBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
        document.getElementById('modalApproveBtn').onclick = () => {
            bootstrap.Modal.getInstance(document.getElementById('viewPayrollModal')).hide();
            approvePayroll(periodId, periodName, 0);
        };
        new bootstrap.Modal(document.getElementById('viewPayrollModal')).show();

        const r = await fetch(`/Manager/GetPayrollDetails?periodId=${periodId}`);
        const data = await r.json();

        if (data.payrolls) {
            let rows = data.payrolls.map(p => `
                <tr>
                    <td>${p.employeeName}</td>
                    <td>${p.department}</td>
                    <td class="text-end">₱${Number(p.basicPay).toLocaleString('en-PH',{minimumFractionDigits:2})}</td>
                    <td class="text-end text-success">₱${Number(p.overtimePay).toLocaleString('en-PH',{minimumFractionDigits:2})}</td>
                    <td class="text-end text-danger">-₱${Number(p.totalDeductions).toLocaleString('en-PH',{minimumFractionDigits:2})}</td>
                    <td class="text-end fw-bold text-primary">₱${Number(p.netPay).toLocaleString('en-PH',{minimumFractionDigits:2})}</td>
                </tr>`).join('');

            document.getElementById('modalPayrollBody').innerHTML = `
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th><th>Dept</th>
                                <th class="text-end">Basic</th>
                                <th class="text-end">OT</th>
                                <th class="text-end">Deductions</th>
                                <th class="text-end">Net Pay</th>
                            </tr>
                        </thead>
                        <tbody>${rows}</tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5">TOTAL</td>
                                <td class="text-end text-primary">₱${Number(data.totalNetPay).toLocaleString('en-PH',{minimumFractionDigits:2})}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>`;
            document.getElementById('modalApproveBtn').onclick = () => {
                bootstrap.Modal.getInstance(document.getElementById('viewPayrollModal')).hide();
                approvePayroll(periodId, periodName, data.totalNetPay);
            };
        }
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function showToast(msg, type) {
        try { PT.Toast[type === 'success' ? 'success' : type === 'warning' ? 'warning' : 'error'](msg); }
        catch { alert(msg); }
    }
</script>
}
