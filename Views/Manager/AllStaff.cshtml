@{
    ViewData["Title"] = "All Staff";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var rows        = ViewBag.Rows        as List<PayroTech.Controllers.StaffRow>         ?? new List<PayroTech.Controllers.StaffRow>();
    var departments = ViewBag.Departments as List<PayroTech.Models.Entities.Department>   ?? new List<PayroTech.Models.Entities.Department>();
    var shifts      = ViewBag.Shifts      as List<PayroTech.Models.Entities.Shift>        ?? new List<PayroTech.Models.Entities.Shift>();
    int total       = ViewBag.TotalCount  ?? 0;
    int page        = ViewBag.CurrentPage ?? 1;
    int totalPages  = ViewBag.TotalPages  ?? 1;
    string? roleFilter  = ViewBag.RoleFilter  as string;
    int?    teamFilter  = ViewBag.TeamFilter  as int?;
    string? search      = ViewBag.Search      as string;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">All Staff</h4>
        <p class="text-muted mb-0">@total staff member@(total != 1 ? "s" : "") in your company</p>
    </div>
    <a href="/Manager/CreateStaff" class="btn btn-primary">
        <i class="bi bi-person-plus me-2"></i>Add Staff
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" action="/Manager/AllStaff" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Name, email, staff code…" value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Role</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    @if (roleFilter == "HR") { <option value="HR" selected>HR</option> }
                    else { <option value="HR">HR</option> }
                    @if (roleFilter == "Accountant") { <option value="Accountant" selected>Accountant</option> }
                    else { <option value="Accountant">Accountant</option> }
                    @if (roleFilter == "Employee") { <option value="Employee" selected>Employee</option> }
                    else { <option value="Employee">Employee</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Team</label>
                <select name="teamId" class="form-select form-select-sm">
                    <option value="">All Teams</option>
                    @foreach (var d in departments)
                    {
                        if (teamFilter == d.Id)
                        {
                            <option value="@d.Id" selected>@d.DepartmentName</option>
                        }
                        else
                        {
                            <option value="@d.Id">@d.DepartmentName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a href="/Manager/AllStaff" class="btn btn-outline-secondary btn-sm" title="Clear filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!rows.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
                <h6>No staff found</h6>
                <p class="text-muted small mb-3">
                    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(roleFilter) || teamFilter.HasValue)
                    {
                        <span>No results match your filters.</span>
                    }
                    else
                    {
                        <span>Start by adding staff members to your company.</span>
                    }
                </p>
                <a href="/Manager/CreateStaff" class="btn btn-primary btn-sm">
                    <i class="bi bi-person-plus me-1"></i>Add First Staff
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Staff Code</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Team</th>
                            <th>Shift</th>
                            <th>Start Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            var roleBadge = row.RoleLabel switch
                            {
                                "HR"         => "bg-success",
                                "Accountant" => "bg-warning text-dark",
                                _            => "bg-primary"
                            };
                            var roleIcon = row.RoleLabel switch
                            {
                                "HR"         => "bi-people-fill",
                                "Accountant" => "bi-calculator-fill",
                                _            => "bi-person-fill"
                            };

                            <tr>
                                <td class="ps-4">
                                    <code class="text-muted small">@(string.IsNullOrEmpty(row.StaffCode) ? "—" : row.StaffCode)</code>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                             style="width:34px;height:34px;font-size:.8rem;background:linear-gradient(135deg,#0891b2,#22d3ee);flex-shrink:0;">
                                            @row.FullName.FirstOrDefault()
                                        </div>
                                        <span class="fw-medium">@row.FullName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @roleBadge">
                                        <i class="bi @roleIcon me-1"></i>@row.RoleLabel
                                    </span>
                                </td>
                                <td><span class="text-muted small">@row.TeamName</span></td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary shift-label-@row.Id">
                                        @(row.ShiftName ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(row.StartDate.HasValue ? row.StartDate.Value.ToString("MMM dd, yyyy") : "—")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button class="btn btn-sm btn-outline-info"
                                                onclick="openShiftModal('@row.Id', '@row.FullName', @(row.CurrentShiftId ?? 0))"
                                                title="Change Shift">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        @if (row.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    title="Deactivate"
                                                    onclick="deactivateStaff('@row.Id', '@row.FullName')">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="pt-pagination">
                    <small class="text-muted me-auto ps-1">
                        Showing @((page - 1) * (int)ViewBag.PageSize + 1)–@(Math.Min(page * (int)ViewBag.PageSize, total)) of @total
                    </small>
                    <button class="pt-pagination-btn" @(page == 1 ? "disabled" : "")
                            onclick="window.location.href='?page=@(page-1)&role=@roleFilter&teamId=@teamFilter&search=@search'">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    @{
                        int startP = Math.Max(1, page - 2);
                        int endP   = Math.Min(totalPages, page + 2);
                        if (startP > 1) {
                            <button class="pt-pagination-btn" onclick="window.location.href='?page=1&role=@roleFilter&teamId=@teamFilter&search=@search'">1</button>
                            if (startP > 2) { <span class="pt-pagination-ellipsis">…</span> }
                        }
                        for (int p2 = startP; p2 <= endP; p2++) {
                            <button class="pt-pagination-btn @(page == p2 ? "active" : "")"
                                    onclick="window.location.href='?page=@p2&role=@roleFilter&teamId=@teamFilter&search=@search'">@p2</button>
                        }
                        if (endP < totalPages) {
                            if (endP < totalPages - 1) { <span class="pt-pagination-ellipsis">…</span> }
                            <button class="pt-pagination-btn" onclick="window.location.href='?page=@totalPages&role=@roleFilter&teamId=@teamFilter&search=@search'">@totalPages</button>
                        }
                    }
                    <button class="pt-pagination-btn" @(page == totalPages ? "disabled" : "")
                            onclick="window.location.href='?page=@(page+1)&role=@roleFilter&teamId=@teamFilter&search=@search'">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
async function deactivateStaff(id, name) {
    if (!confirm(`Deactivate "${name}"? They will lose access to the system.`)) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const res = await fetch('/Manager/DeactivateStaff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `id=${encodeURIComponent(id)}&__RequestVerificationToken=${encodeURIComponent(token)}`
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.message ?? 'Failed to deactivate staff.');
}

let _shiftUserId = null;

function openShiftModal(userId, name, currentShiftId) {
    _shiftUserId = userId;
    document.getElementById('shiftModalName').textContent = name;
    const sel = document.getElementById('shiftModalSelect');
    if (currentShiftId) sel.value = currentShiftId;
    new bootstrap.Modal(document.getElementById('shiftModal')).show();
}

async function saveShift() {
    const shiftId = document.getElementById('shiftModalSelect').value;
    const token   = document.querySelector('input[name="__RequestVerificationToken"]').value;

    const res  = await fetch('/Manager/UpdateShift', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `userId=${encodeURIComponent(_shiftUserId)}&shiftId=${shiftId}&__RequestVerificationToken=${encodeURIComponent(token)}`
    });
    const data = await res.json();

    if (data.success) {
        const badge = document.querySelector(`.shift-label-${_shiftUserId}`);
        if (badge) badge.textContent = data.shiftName;
        bootstrap.Modal.getInstance(document.getElementById('shiftModal')).hide();
    } else {
        alert(data.message);
    }
}
</script>

<!-- Shift Edit Modal -->
<div class="modal fade" id="shiftModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Change Shift</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Changing shift for: <strong id="shiftModalName"></strong></p>
                <label class="form-label fw-semibold">Select Shift</label>
                <select id="shiftModalSelect" class="form-select">
                    @foreach (var s in shifts)
                    {
                        <option value="@s.Id">@s.ShiftName (@s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm"))</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveShift()">
                    <i class="bi bi-floppy me-1"></i>Save Shift
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
}
