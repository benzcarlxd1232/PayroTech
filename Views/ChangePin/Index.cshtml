@{
    ViewData["Title"] = "Change Kiosk PIN";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Kiosk PIN — PayroTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family:'Inter',sans-serif; background:#f1f5f9; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px; }
        .card { width:100%; max-width:420px; border-radius:16px; padding:2rem; box-shadow:0 4px 24px rgba(0,0,0,.09); border:none; }
        .pin-icon { width:56px;height:56px;background:linear-gradient(135deg,#2563eb,#60a5fa);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.6rem;color:#fff; }
        .form-label { font-weight:600;font-size:.875rem;color:#374151; }
        .form-control { border-radius:8px;font-size:1.1rem;letter-spacing:4px;text-align:center; }
        .form-control:focus { border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.12); }
        .btn-save { width:100%;padding:.7rem;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border:none;border-radius:10px;font-size:.95rem;font-weight:600;cursor:pointer;transition:all .2s;margin-top:1rem; }
        .btn-save:hover { filter:brightness(1.08);transform:translateY(-1px); }
        .staff-code-box { background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.75rem 1rem;text-align:center;margin-bottom:1.5rem; }
        .staff-code-box .lbl { font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;color:#6b7280;margin-bottom:4px; }
        .staff-code-box .code { font-family:'Courier New',monospace;font-size:1.3rem;font-weight:700;color:#1e293b;letter-spacing:3px; }
        .pin-hint { font-size:.8rem;color:#6b7280;text-align:center;margin-top:.5rem; }
    </style>
</head>
<body>
<div class="card">
    <div class="pin-icon"><i class="bi bi-shield-lock"></i></div>
    <h5 class="text-center fw-bold mb-1">Change Kiosk PIN</h5>
    <p class="text-center text-muted small mb-4">Your PIN is used at the kiosk for dual verification.</p>

    <div class="staff-code-box">
        <div class="lbl">Your Staff Code</div>
        <div class="code">@ViewBag.StaffCode</div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2 small mb-3">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label class="form-label">New 4-Digit PIN</label>
            <input type="password" name="newPin" class="form-control" maxlength="4" inputmode="numeric"
                   pattern="[0-9]{4}" placeholder="••••" required autocomplete="off" />
        </div>

        <div class="mb-3">
            <label class="form-label">Confirm PIN</label>
            <input type="password" name="confirmPin" class="form-control" maxlength="4" inputmode="numeric"
                   pattern="[0-9]{4}" placeholder="••••" required autocomplete="off" />
        </div>

        <p class="pin-hint">
            Default PIN is the last 4 digits of your staff code:
            <strong>@(ViewBag.CurrentPin)</strong>
        </p>

        <button type="submit" class="btn-save">
            <i class="bi bi-floppy me-2"></i>Save New PIN
        </button>
    </form>

    <div class="text-center mt-3">
        <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
