<!-- Generate Report Modal -->
<div class="modal fade" id="generateReportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-plus me-2"></i>Generate Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Report Type</label>
                        <select class="form-select">
                            <option>Payroll Summary</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Period</label>
                            <select class="form-select">
                                <option>March 2026</option>
                                <option>February 2026</option>
                                <option>January 2026</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Format</label>
                            <select class="form-select">
                                <option>PDF</option>
                                <option>Excel</option>
                                <option>CSV</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department/Team</label>
                        <select class="form-select">
                            <option>All Departments</option>
                            <option>Engineering</option>
                            <option>Design</option>
                            <option>Marketing</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="pt-btn pt-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="pt-btn pt-btn-primary">
                    <i class="bi bi-download me-2"></i>Generate Report
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .report-item {
        color: var(--pt-text-primary);
        transition: background 0.2s;
    }
    .report-item:hover {
        background: var(--pt-bg-secondary);
    }
    .report-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }
</style>
