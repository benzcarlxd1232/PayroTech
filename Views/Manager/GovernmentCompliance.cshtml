    </div>
</div>

<!-- Configuration Section -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="pt-card h-100">
            <div class="pt-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-gear me-2"></i>Contribution Rates</span>
                <button class="pt-btn pt-btn-ghost pt-btn-sm">
                    <i class="bi bi-pencil me-1"></i>Edit
                </button>
            </div>
            <div class="pt-card-body">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Contribution</th>
                            <th>Employee</th>
                            <th>Employer</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>SSS</strong></td>
                            <td>4.5%</td>
                            <td>9.5%</td>
                        </tr>
                        <tr>
                            <td><strong>PhilHealth</strong></td>
                            <td>2.5%</td>
                            <td>2.5%</td>
                        </tr>
                        <tr>
                            <td><strong>Pag-IBIG</strong></td>
                            <td>₱100 (max)</td>
                            <td>₱100 (max)</td>
                        </tr>
                    </tbody>
                </table>
                <div class="alert alert-info mt-3 mb-0 small">
                    <i class="bi bi-info-circle me-2"></i>
                    Rates are based on latest government mandates. Updated as of January 2026.
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="pt-card h-100">
            <div class="pt-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-building me-2"></i>Company Registration Numbers</span>
                <button class="pt-btn pt-btn-ghost pt-btn-sm">
                    <i class="bi bi-pencil me-1"></i>Edit
                </button>
            </div>
            <div class="pt-card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <strong>SSS Employer Number</strong>
                        <div class="small text-muted">Social Security System</div>
                    </div>
                    <code class="fs-6">34-1234567-8</code>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <strong>PhilHealth Employer Number</strong>
                        <div class="small text-muted">Philippine Health Insurance</div>
                    </div>
                    <code class="fs-6">12-345678901-0</code>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <strong>Pag-IBIG Employer Number</strong>
                        <div class="small text-muted">Home Development Mutual Fund</div>
                    </div>
                    <code class="fs-6">123456789012</code>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>TIN</strong>
                        <div class="small text-muted">Bureau of Internal Revenue</div>
                    </div>
                    <code class="fs-6">123-456-789-000</code>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Remittance History -->
