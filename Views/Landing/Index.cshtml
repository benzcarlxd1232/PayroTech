<!-- ── HERO ── -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-content">
                <h1>Smart Payroll & HR for <span>Philippine Businesses</span></h1>
                <p class="lead">Automate attendance, payroll, and compliance — built for the Philippine labor code.</p>
