@model CreateEmployeeViewModel
@{
    ViewData["Title"] = "Create Employee";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Create New Employee</h4>
        <p class="text-muted mb-0">Add a new employee to your team — salary is set by the manager</p>
    </div>
    <a asp-action="MyTeam" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Team
    </a>
</div>

<!-- HR Role Notice -->
<div class="alert alert-info d-flex align-items-center gap-3 mb-4">
    <div style="width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#2563eb,#60a5fa);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;">
        <i class="bi bi-person-fill fs-5"></i>
    </div>
    <div>
        <strong>Employee Role Only</strong> — As HR, you can only create <span class="badge bg-primary">Employee</span> accounts.
        To create HR or Accountant staff, contact your Manager.
        Salary is automatically set from <strong>Company Settings</strong>.
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="CreateEmployee" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Personal Information -->
            <h6 class="fw-semibold mb-3"><i class="bi bi-person me-2"></i>Personal Information</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MiddleName" class="form-label">Middle Name</label>
                    <input asp-for="MiddleName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PhoneNumber" class="form-label">Contact Number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="09XXXXXXXXX" maxlength="11" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BirthDate" class="form-label">Birth Date <span class="text-danger">*</span></label>
                    <input asp-for="BirthDate" class="form-control" type="date" />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Select</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="CivilStatus" class="form-label">Civil Status</label>
                    <select asp-for="CivilStatus" class="form-select">
                        <option value="">Select</option>
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Widowed">Widowed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="BloodType" class="form-label">Blood Type</label>
                    <select asp-for="BloodType" class="form-select">
                        <option value="">Select</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>
                <div class="col-md-9">
                    <label asp-for="Address" class="form-label">Address</label>
                    <input asp-for="Address" class="form-control" placeholder="Complete address" />
                </div>
            </div>

            <hr class="my-4">

            <!-- Assignment -->
            <h6 class="fw-semibold mb-3"><i class="bi bi-briefcase me-2"></i>Assignment</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="DepartmentId" class="form-label">Team / Department</label>
                    <select asp-for="DepartmentId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Departments, "Id", "DepartmentName"))">
                        <option value="">-- Select Team --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ShiftId" class="form-label">Shift</label>
                    <select asp-for="ShiftId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Shifts, "Id", "ShiftName"))">
                        <option value="">-- Select Shift --</option>
                    </select>
                </div>
            </div>

            <hr class="my-4">

            <!-- Emergency Contact -->
            <h6 class="fw-semibold mb-3"><i class="bi bi-telephone me-2"></i>Emergency Contact</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="EmergencyContactName" class="form-label">Contact Name</label>
                    <input asp-for="EmergencyContactName" class="form-control" placeholder="Full name" />
                </div>
                <div class="col-md-4">
                    <label asp-for="EmergencyContactRelation" class="form-label">Relationship</label>
                    <input asp-for="EmergencyContactRelation" class="form-control" placeholder="e.g., Spouse, Parent" />
                </div>
                <div class="col-md-4">
                    <label asp-for="EmergencyContactNumber" class="form-label">Contact Number</label>
                    <input asp-for="EmergencyContactNumber" class="form-control" placeholder="09XXXXXXXXX" maxlength="11" />
                </div>
            </div>

            <div class="alert alert-info">
                <i class="bi bi-envelope me-2"></i>
                A welcome email with a <strong>randomly generated secure temporary password</strong> will be sent to the employee's email.
                Salary is automatically set from <strong>Company Settings</strong> (managed by the manager).
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i>Create Employee
                </button>
                <a asp-action="MyTeam" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
