@model PayroTech.Models.ViewModels.EnhancedChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = null; // Standalone — no sidebar, works for all roles
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password — PayroTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --primary:#2563eb; --primary-dark:#1d4ed8; }
        body { font-family:'Inter',sans-serif; background:#f1f5f9; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .cp-card { background:#fff; border-radius:16px; padding:40px 36px; width:100%; max-width:420px; box-shadow:0 4px 24px rgba(0,0,0,.08); }
        .cp-icon { width:56px;height:56px;background:linear-gradient(135deg,#2563eb,#60a5fa);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;font-size:1.6rem;color:#fff; }
        .cp-title { font-size:1.3rem;font-weight:700;text-align:center;margin-bottom:.4rem; }
        .cp-sub { font-size:.9rem;color:#64748b;text-align:center;margin-bottom:1.5rem; }
        .forced-banner { background:#fef3c7;border:1px solid #f59e0b;border-radius:10px;padding:.75rem 1rem;margin-bottom:1.5rem;display:flex;align-items:flex-start;gap:.6rem;font-size:.875rem;color:#92400e; }
        .forced-banner i { font-size:1.1rem;flex-shrink:0;margin-top:.05rem; }
        .form-label { font-weight:600;font-size:.875rem;color:#374151; }
        .form-control { border-radius:10px;font-size:.9rem; }
        .form-control:focus { border-color:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.12); }
        .btn-submit { width:100%;padding:.7rem;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;border:none;border-radius:10px;font-size:.95rem;font-weight:600;cursor:pointer;transition:all .2s;margin-top:1.25rem; }
        .btn-submit:hover { filter:brightness(1.08);transform:translateY(-1px); }
        .progress-wrap { margin-bottom:1.5rem; }
        .progress-labels { display:flex;justify-content:space-between;font-size:.8rem;color:#64748b;margin-bottom:.4rem; }
        .progress { height:6px;border-radius:3px; }
        .text-danger { font-size:.8rem; }
    </style>
</head>
<body>
<div class="cp-card">
    <div class="cp-icon"><i class="bi bi-shield-lock"></i></div>
    <div class="cp-title">@(Model.IsFirstTimeChange ? "Set Your Password" : "Change Password")</div>
    <div class="cp-sub">
        @if (Model.IsFirstTimeChange)
        {
            <span>Hi <strong>@Model.UserName</strong>, create a secure password to continue.</span>
        }
        else
        {
            <span>Update your account password.</span>
        }
    </div>

    @if (Model.IsFirstTimeChange)
    {
        <div class="forced-banner">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>You are using a <strong>temporary password</strong>. You must set a new password before accessing the system.</span>
        </div>

        <div class="progress-wrap">
            <div class="progress-labels"><span>Account Setup</span><span>Step 1 of 2</span></div>
            <div class="progress"><div class="progress-bar bg-primary" style="width:50%"></div></div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small"><i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]</div>
    }

    <form method="post" asp-controller="Auth" asp-action="ChangePassword">
        @Html.AntiForgeryToken()

        @if (!Model.IsFirstTimeChange)
        {
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" required />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
        }

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 12 chars: A-Z, a-z, 0-9, special" required />
            <div class="mt-1 small text-muted">Must be at least 12 characters with uppercase, lowercase, number, and special character.</div>
            <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <button type="submit" class="btn-submit">
            <i class="bi bi-shield-check me-2"></i>
            @(Model.IsFirstTimeChange ? "Set Password & Continue" : "Update Password")
        </button>
    </form>

    @if (Model.IsFirstTimeChange)
    {
        <p class="text-center text-muted small mt-3 mb-0">
            <i class="bi bi-arrow-right-circle me-1"></i>
            Next: face enrollment for attendance tracking.
        </p>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>