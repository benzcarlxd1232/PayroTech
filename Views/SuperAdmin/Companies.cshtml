@model IEnumerable<PayroTech.Models.ViewModels.CompanyListItem>
@{
    ViewData["Title"] = "Company Management";
    Layout = "_SuperAdminLayout";
    
    // Pagination settings
    var pageSize = 10;
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    var itemsList = Model.ToList();
    var totalItems = itemsList.Count;
    var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
    var pagedItems = itemsList.Skip((currentPage - 1) * pageSize).Take(pageSize);
}

<style>
    /* Dark mode fixes for Company Management */
    body.dark-mode .table-card {
        background: var(--bg-card) !important;
        border-color: var(--border-color) !important;
    }
    
    body.dark-mode .table {
        color: var(--text-light) !important;
    }
    
    body.dark-mode .table thead {
        background: rgba(0,0,0,0.3) !important;
    }
    
    body.dark-mode .table thead th {
        background: transparent !important;
        color: var(--text-light) !important;
        border-color: var(--border-color) !important;
    }
    
    body.dark-mode .table tbody td {
        background: transparent !important;
        color: var(--text-light) !important;
        border-color: var(--border-color) !important;
    }
    
    body.dark-mode .table-hover tbody tr:hover td {
        background: rgba(139, 92, 246, 0.1) !important;
    }
    
    body.dark-mode .table-light {
        background: rgba(0,0,0,0.2) !important;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <span class="text-muted">Total: @totalItems companies registered</span>
    <a href="/SuperAdmin/CreateCompany" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Add New Company
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Company Name</th>
                    <th>Plan</th>
                    <th class="text-end">Employees</th>
                    <th>Subscription Start</th>
                    <th>Subscription End</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!pagedItems.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No companies registered yet. <a href="/SuperAdmin/CreateCompany">Create your first company</a>
                        </td>
                    </tr>
                }
                @foreach (var company in pagedItems)
                {
                    var daysUntilExpiry = company.SubscriptionEnd.HasValue ? 
                        (company.SubscriptionEnd.Value - DateTime.Today).Days : 999;
                    var isExpiringSoon = daysUntilExpiry <= 14 && daysUntilExpiry > 0;
                    
                    <tr>
                        <td><strong>@company.CompanyName</strong></td>
                        <td><span class="text-primary fw-semibold">Professional</span></td>
                        <td class="text-end">@company.EmployeeCount</td>
                        <td>@company.SubscriptionStart?.ToString("MMM dd, yyyy")</td>
                        <td>
                            @company.SubscriptionEnd?.ToString("MMM dd, yyyy")
                            @if (isExpiringSoon)
                            {
                                <span class="badge bg-warning text-dark ms-1">Expiring Soon</span>
                            }
                        </td>
                        <td>
                            @if (company.IsActive && company.IsSubscriptionActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (!company.IsSubscriptionActive)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="/SuperAdmin/CompanyDetails/@company.Id" class="btn btn-sm btn-outline-primary" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/SuperAdmin/EditCompany/@company.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="pt-pagination">
        <small class="text-muted me-auto ps-1">
            Showing @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, totalItems) of @totalItems entries
        </small>

        <button class="pt-pagination-btn" @(currentPage == 1 ? "disabled" : "")
                onclick="window.location.href='?page=@(currentPage - 1)'">
            <i class="bi bi-chevron-left"></i>
        </button>

        @{
            int startPage = Math.Max(1, currentPage - 2);
            int endPage   = Math.Min(totalPages, currentPage + 2);

            if (startPage > 1)
            {
                <button class="pt-pagination-btn" onclick="window.location.href='?page=1'">1</button>
                if (startPage > 2) { <span class="pt-pagination-ellipsis">…</span> }
            }

            for (int i = startPage; i <= endPage; i++)
            {
                <button class="pt-pagination-btn @(currentPage == i ? "active" : "")"
                        onclick="window.location.href='?page=@i'">@i</button>
            }

            if (endPage < totalPages)
            {
                if (endPage < totalPages - 1) { <span class="pt-pagination-ellipsis">…</span> }
                <button class="pt-pagination-btn" onclick="window.location.href='?page=@totalPages'">@totalPages</button>
            }
        }

        <button class="pt-pagination-btn" @(currentPage == totalPages ? "disabled" : "")
                onclick="window.location.href='?page=@(currentPage + 1)'">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>
