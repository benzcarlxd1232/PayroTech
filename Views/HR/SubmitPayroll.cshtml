@{
    ViewData["Title"] = "Submit Payroll";
    Layout = "~/Views/Shared/_HRLayout.cshtml";

    var periodStart    = (DateTime)(ViewBag.PeriodStart ?? DateTime.Today);
    var periodEnd      = (DateTime)(ViewBag.PeriodEnd   ?? DateTime.Today);
    var payDate        = (DateTime)(ViewBag.PayDate     ?? DateTime.Today.AddDays(5));
    var totalEmployees = (int)(ViewBag.TotalEmployees   ?? 0);
    var totalBasicPay  = (decimal)(ViewBag.TotalBasicPay  ?? 0m);
    var totalOtPay     = (decimal)(ViewBag.TotalOtPay     ?? 0m);
    var totalDeduct    = (decimal)(ViewBag.TotalDeduct    ?? 0m);
    var totalNetPay    = (decimal)(ViewBag.TotalNetPay    ?? 0m);
    var totalSss       = (decimal)(ViewBag.TotalSss       ?? 0m);
    var totalPhilHealth= (decimal)(ViewBag.TotalPhilHealth?? 0m);
    var totalPagIbig   = (decimal)(ViewBag.TotalPagIbig   ?? 0m);
    var totalTax       = (decimal)(ViewBag.TotalTax       ?? 0m);
    var alreadySubmitted = (bool)(ViewBag.AlreadySubmitted ?? false);
    var existingStatus   = ViewBag.ExistingStatus as string;

    var payrollItems = ViewBag.PayrollItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Submit Payroll</h4>
        <p class="text-muted mb-0">Review and submit payroll for manager approval</p>
    </div>
    <a href="/HR/Payroll" class="pt-btn pt-btn-ghost">
        <i class="bi bi-arrow-left me-2"></i>Back to Payroll
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i>@Html.Raw(TempData["Success"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (alreadySubmitted)
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Already Submitted:</strong> Payroll for @periodStart.ToString("MMMM yyyy") has already been submitted (Status: <strong>@existingStatus</strong>). You cannot submit again for the same period.
    </div>
}

@if (totalEmployees == 0)
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>No employees found</strong> in your team for this period. Make sure employees are assigned to your team and have attendance records.
    </div>
}

<!-- Period Header -->
<div class="pt-card mb-4" style="background:linear-gradient(135deg,#059669,#34d399);color:white;">
    <div class="pt-card-body">
        <div class="row align-items-center">
            <div class="col-md-5">
                <h5 class="text-white mb-1">Payroll Period: @periodStart.ToString("MMMM yyyy")</h5>
                <p class="mb-0 opacity-75">@periodStart.ToString("MMM dd") – @periodEnd.ToString("MMM dd, yyyy")</p>
            </div>
            <div class="col-md-3 text-center border-start border-white border-opacity-25">
                <div class="opacity-75 small">Pay Date</div>
                <h5 class="text-white mb-0">@payDate.ToString("MMM dd, yyyy")</h5>
            </div>
            <div class="col-md-4 text-center border-start border-white border-opacity-25">
                <div class="opacity-75 small">Total Employees</div>
                <h4 class="text-white mb-0">@totalEmployees</h4>
            </div>
        </div>
    </div>
</div>

<!-- Summary + Per-Employee Table -->
<div class="row mb-4">
    <div class="col-md-5">
        <div class="pt-card h-100">
            <div class="pt-card-header"><i class="bi bi-receipt me-2"></i>Payroll Summary</div>
            <div class="pt-card-body">
                <table class="table table-borderless mb-0 small">
                    <tbody>
                        <tr><td class="text-muted">Total Basic Pay</td><td class="text-end">₱@totalBasicPay.ToString("N2")</td></tr>
                        <tr><td class="text-muted">Total Overtime</td><td class="text-end text-success">+ ₱@totalOtPay.ToString("N2")</td></tr>
                        <tr class="border-top"><td class="text-muted">SSS</td><td class="text-end text-danger">- ₱@totalSss.ToString("N2")</td></tr>
                        <tr><td class="text-muted">PhilHealth</td><td class="text-end text-danger">- ₱@totalPhilHealth.ToString("N2")</td></tr>
                        <tr><td class="text-muted">Pag-IBIG</td><td class="text-end text-danger">- ₱@totalPagIbig.ToString("N2")</td></tr>
                        <tr><td class="text-muted">Withholding Tax</td><td class="text-end text-danger">- ₱@totalTax.ToString("N2")</td></tr>
                        <tr class="border-top">
                            <td><strong>Total Net Payroll</strong></td>
                            <td class="text-end"><strong class="text-primary fs-5">₱@totalNetPay.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="pt-card h-100">
            <div class="pt-card-header"><i class="bi bi-people me-2"></i>Employee Breakdown</div>
            <div class="pt-card-body p-0">
                <div style="max-height:280px;overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0 small">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Employee</th>
                                <th class="text-center">Days</th>
                                <th class="text-center">OT hrs</th>
                                <th class="text-end">Basic</th>
                                <th class="text-end">Net Pay</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in payrollItems)
                            {
                                <tr>
                                    <td>@item.FullName</td>
                                    <td class="text-center">@item.DaysWorked</td>
                                    <td class="text-center">@item.OtHours</td>
                                    <td class="text-end">₱@((decimal)item.BasicPay).ToString("N0")</td>
                                    <td class="text-end fw-semibold text-success">₱@((decimal)item.NetPay).ToString("N0")</td>
                                </tr>
                            }
                            @if (!payrollItems.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No employees found</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Submit Form -->
@if (!alreadySubmitted && totalEmployees > 0)
{
    <div class="pt-card">
        <div class="pt-card-header"><i class="bi bi-send me-2"></i>Submit for Approval</div>
        <div class="pt-card-body">
            <form asp-action="SubmitPayroll" asp-controller="HR" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label">Notes for Manager (Optional)</label>
                    <textarea class="form-control" name="notes" rows="3"
                              placeholder="Add any notes or comments regarding this payroll submission..."></textarea>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="confirmCheck">
                    <label class="form-check-label" for="confirmCheck">
                        I confirm that all information in this payroll submission is accurate and complete.
                    </label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="pt-btn pt-btn-primary" id="submitBtn" disabled>
                        <i class="bi bi-send me-2"></i>Submit Payroll for Approval
                    </button>
                    <a href="/HR/Payroll" class="pt-btn pt-btn-ghost">
                        <i class="bi bi-x me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
}
else if (alreadySubmitted)
{
    <div class="pt-card">
        <div class="pt-card-body text-center py-4">
            <i class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
            <h5>Payroll Already Submitted</h5>
            <p class="text-muted">The payroll for @periodStart.ToString("MMMM yyyy") is currently <strong>@existingStatus</strong>.</p>
            <a href="/HR/Payroll" class="pt-btn pt-btn-primary">Back to Payroll</a>
        </div>
    </div>
}

@section Scripts {
<script>
    document.getElementById('confirmCheck')?.addEventListener('change', function () {
        document.getElementById('submitBtn').disabled = !this.checked;
    });
</script>
}
