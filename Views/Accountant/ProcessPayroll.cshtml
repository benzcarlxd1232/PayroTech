@{
    ViewData["Title"] = "Process Payroll";
    Layout = "~/Views/Shared/_AccountantLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Process Payroll</h4>
        <p class="text-muted mb-0">Payroll processing is managed by the system based on attendance records.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-calculator fs-1 text-muted d-block mb-3"></i>
        <h5>Payroll Processing</h5>
        <p class="text-muted">Payroll is automatically calculated from attendance records, overtime, and deductions.<br>
        Processed payrolls will appear in <a href="/Accountant/PendingPayrolls">Pending Payrolls</a> for distribution.</p>
        <a href="/Accountant/PendingPayrolls" class="btn btn-warning mt-2">
            <i class="bi bi-hourglass-split me-2"></i>View Pending Payrolls
        </a>
    </div>
</div>
