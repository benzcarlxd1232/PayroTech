@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - PayroTech</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --accent:#0891b2; --accent-dark:#0e7490; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#0f172a,#1e3a5f); }
        .card { background:#fff; border-radius:16px; padding:40px 36px; width:100%; max-width:420px; box-shadow:0 20px 50px rgba(0,0,0,.4); }
        .icon-wrap { width:64px; height:64px; background:linear-gradient(135deg,var(--accent),var(--accent-dark)); border-radius:16px; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:1.8rem; color:#fff; }
        h3 { font-size:1.4rem; font-weight:700; color:#0f172a; text-align:center; margin-bottom:6px; }
        .sub { font-size:.85rem; color:#64748b; text-align:center; margin-bottom:28px; line-height:1.5; }
        .form-label { font-size:.85rem; font-weight:600; color:#374151; margin-bottom:5px; }
        .input-wrap { position:relative; }
        .input-wrap .icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .input-wrap input { width:100%; padding:11px 14px 11px 40px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:.9rem; outline:none; transition:border-color .2s,box-shadow .2s; font-family:inherit; }
        .input-wrap input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(8,145,178,.12); }
        .btn-submit { width:100%; padding:12px; background:linear-gradient(135deg,var(--accent),var(--accent-dark)); color:#fff; border:none; border-radius:10px; font-size:.95rem; font-weight:600; cursor:pointer; margin-top:8px; transition:opacity .2s,transform .2s; }
        .btn-submit:hover { opacity:.92; transform:translateY(-1px); }
        .alert-err { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; border-radius:10px; padding:12px 16px; font-size:.85rem; margin-bottom:20px; }
        .alert-ok { background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a; border-radius:10px; padding:12px 16px; font-size:.85rem; margin-bottom:20px; }
        .back-link { display:block; text-align:center; margin-top:24px; }
        .back-link a { font-size:.85rem; color:#94a3b8; text-decoration:none; transition:color .2s; }
        .back-link a:hover { color:var(--accent); }
        .info-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:14px 16px; margin-bottom:24px; }
        .info-box p { font-size:.82rem; color:#64748b; margin:0; line-height:1.5; }
        .info-box i { color:var(--accent); }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="bi bi-envelope-paper"></i></div>
        <h3>Forgot Password?</h3>
        <p class="sub">Enter your registered email address and we'll send a verification code to confirm your identity.</p>

        <div class="info-box">
            <p><i class="bi bi-shield-check me-1"></i> For security, a 6-digit OTP code will be sent to verify your identity before you can reset your password. No passwords are ever sent via email.</p>
        </div>

        @if (TempData["ForgotPasswordSuccess"] != null)
        {
            <div class="alert-ok">
                <i class="bi bi-check-circle me-2"></i>@TempData["ForgotPasswordSuccess"]
            </div>
        }

        @if (TempData["ForgotPasswordError"] != null)
        {
            <div class="alert-err">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["ForgotPasswordError"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-err">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-circle me-1"></i>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="form-label">Email Address</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope icon"></i>
                    <input type="email" name="email" placeholder="you@company.com" autocomplete="email" required />
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="bi bi-send me-2"></i>Send Verification Code
            </button>
        </form>

        <div class="back-link">
            <a href="/Auth/Login"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
        </div>
    </div>
</body>
</html>
