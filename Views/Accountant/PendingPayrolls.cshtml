@{
    ViewData["Title"] = "Pending Payrolls";
    Layout = "~/Views/Shared/_AccountantLayout.cshtml";
    var payrolls    = ViewBag.Payrolls    as List<PayroTech.Models.Entities.Payroll> ?? new();
    int totalCount  = ViewBag.TotalCount  ?? payrolls.Count;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages  = ViewBag.TotalPages  ?? 1;
    int pageSize    = ViewBag.PageSize    ?? 15;
    int startP      = Math.Max(1, currentPage - 2);
    int endP        = Math.Min(totalPages, currentPage + 2);

    // Group by period then by department — accountant sees DEPARTMENT TOTALS only, not individual salaries
    var byPeriod = payrolls
        .GroupBy(p => new { p.PayrollPeriodId, Name = p.PayrollPeriod?.PeriodName ?? "Unknown" })
        .ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i>@Html.Raw(TempData["Success"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Pending Payrolls</h4>
        <p class="text-muted mb-0">Approved budgets ready for salary distribution</p>
    </div>
    @if (payrolls.Any())
    {
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Total pending:</span>
            <strong class="text-success fs-5">₱@payrolls.Sum(p => p.NetPay).ToString("N2")</strong>
        </div>
    }
</div>

<!-- Accountant role info -->
<div class="alert alert-info d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-info-circle fs-4"></i>
    <div>
        <strong>Accountant View</strong> — You see the <strong>total approved budget per department</strong>.
        Individual employee salaries are managed by the Manager.
        Click <strong>"Distribute All"</strong> to release the budget to all staff in that department.
    </div>
</div>

@if (!payrolls.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-3"></i>
            <h6>No pending payrolls</h6>
            <p class="text-muted small">All payrolls have been distributed. Check Payroll History for records.</p>
            <a href="/Accountant/PayrollHistory" class="btn btn-outline-primary btn-sm">View History</a>
        </div>
    </div>
}
else
{
    @foreach (var group in byPeriod)
    {
        var periodTotal = group.Sum(p => p.NetPay);
        var periodId    = group.Key.PayrollPeriodId;
        var periodName  = group.Key.Name;

        // Group by department — show department totals only
        var byDept = group
            .GroupBy(p => p.Employee?.Department?.DepartmentName ?? "General")
            .Select(g => new {
                DeptName     = g.Key,
                EmployeeCount = g.Count(),
                TotalBudget  = g.Sum(p => p.NetPay)
            })
            .OrderBy(d => d.DeptName)
            .ToList();

        <div class="card shadow-sm mb-4">
            <!-- Period Header -->
            <div class="card-header d-flex justify-content-between align-items-center py-3"
                 style="background:linear-gradient(135deg,#f59e0b15,#fbbf2415);">
                <div>
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-calendar-check me-2 text-warning"></i>@periodName
                    </h6>
                    <small class="text-muted">
                        @byDept.Sum(d => d.EmployeeCount) employees across @byDept.Count department(s) ·
                        Total: <strong class="text-success">₱@periodTotal.ToString("N2")</strong>
                    </small>
                </div>
                <button class="btn btn-success btn-sm fw-semibold px-4"
                        onclick="markAllAsPaid(@periodId, '@periodName', @periodTotal)">
                    <i class="bi bi-send-check me-2"></i>Distribute All (₱@periodTotal.ToString("N0"))
                </button>
            </div>

            <!-- Department Budget Table — NO individual salaries -->
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Department</th>
                            <th class="text-center">Employees</th>
                            <th class="text-end">Total Budget to Distribute</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in byDept)
                        {
                            // Get payroll IDs for this department in this period
                            var deptPayrollIds = group
                                .Where(p => (p.Employee?.Department?.DepartmentName ?? "General") == dept.DeptName)
                                .Select(p => p.Id)
                                .ToList();

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@dept.DeptName</div>
                                    <div class="text-muted small">@dept.EmployeeCount employee(s)</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@dept.EmployeeCount</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-success fs-5">₱@dept.TotalBudget.ToString("N2")</span>
                                    <div class="text-muted small">Approved by Manager</div>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-success"
                                            onclick="distributeDept(@periodId, '@dept.DeptName', @dept.TotalBudget, '@periodName')">
                                        <i class="bi bi-send me-1"></i>Distribute
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2" class="ps-4 fw-bold">Period Total</td>
                            <td class="text-end fw-bold text-success fs-5">₱@periodTotal.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="pt-pagination">
            <small class="text-muted me-auto ps-1">
                Showing @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, totalCount) of @totalCount records
            </small>
            <button class="pt-pagination-btn" @(currentPage == 1 ? "disabled" : "")
                    onclick="window.location.href='?page=@(currentPage - 1)'">
                <i class="bi bi-chevron-left"></i>
            </button>
            @for (int i = startP; i <= endP; i++)
            {
                <button class="pt-pagination-btn @(currentPage == i ? "active" : "")"
                        onclick="window.location.href='?page=@i'">@i</button>
            }
            <button class="pt-pagination-btn" @(currentPage == totalPages ? "disabled" : "")
                    onclick="window.location.href='?page=@(currentPage + 1)'">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
}

@section Scripts {
<script>
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function showToast(msg, type) {
        try { PT.Toast[type](msg); } catch { alert(msg); }
    }

    async function distributeDept(periodId, deptName, total, periodName) {
        if (!confirm(`Distribute ₱${Number(total).toLocaleString('en-PH',{minimumFractionDigits:2})} to ${deptName}?\n\nThis will mark all employees in ${deptName} as paid for ${periodName}.`)) return;

        const fd = new FormData();
        fd.append('periodId', periodId);
        fd.append('deptName', deptName);
        fd.append('__RequestVerificationToken', getToken());

        const r    = await fetch('/Accountant/MarkDeptAsPaid', { method: 'POST', body: fd });
        const data = await r.json();

        if (data.success) {
            showToast(`✅ ${deptName} salaries distributed! ₱${Number(data.total).toLocaleString('en-PH',{minimumFractionDigits:2})}`, 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast(data.message, 'error');
        }
    }

    async function markAllAsPaid(periodId, periodName, total) {
        if (!confirm(`Distribute ALL salaries for "${periodName}"?\nTotal: ₱${Number(total).toLocaleString('en-PH',{minimumFractionDigits:2})}\n\nThis will mark all departments as paid.`)) return;

        const fd = new FormData();
        fd.append('periodId', periodId);
        fd.append('__RequestVerificationToken', getToken());

        const r    = await fetch('/Accountant/MarkAllAsPaid', { method: 'POST', body: fd });
        const data = await r.json();

        if (data.success) {
            showToast(`✅ ${data.count} salaries distributed! Total: ₱${Number(data.total).toLocaleString('en-PH',{minimumFractionDigits:2})}`, 'success');
            setTimeout(() => location.reload(), 1800);
        } else {
            showToast(data.message, 'error');
        }
    }
</script>
}
