@{
    ViewData["Title"] = "HR Management";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">HR Management</h4>
        <p class="text-muted mb-0">Manage HR assignments and permissions</p>
    </div>
    <button class="pt-btn pt-btn-primary" data-bs-toggle="modal" data-bs-target="#addHRModal">
        <i class="bi bi-person-plus me-2"></i>Add New HR
    </button>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="pt-stats-card">
            <div class="pt-stats-value">5</div>
            <div class="pt-stats-label">Total HR Personnel</div>
            <i class="bi bi-people pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card success">
            <div class="pt-stats-value">4</div>
            <div class="pt-stats-label">Active</div>
            <i class="bi bi-check-circle pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card warning">
            <div class="pt-stats-value">1</div>
            <div class="pt-stats-label">On Leave</div>
            <i class="bi bi-calendar-x pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-stats-card">
            <div class="pt-stats-value">6</div>
            <div class="pt-stats-label">Teams Covered</div>
            <i class="bi bi-diagram-3 pt-stats-icon"></i>
        </div>
    </div>
</div>

