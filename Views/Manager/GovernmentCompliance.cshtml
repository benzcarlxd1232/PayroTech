                        <th>Period</th>
                        <th>Type</th>
                        <th class="text-end">Employee Share</th>
                        <th class="text-end">Employer Share</th>
                        <th class="text-end">Total</th>
                        <th>Remittance Date</th>
                        <th>Status</th>
                        <th>Receipt</th>
