@{
    ViewData["Title"] = "Government Compliance";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Government Compliance</h4>
        <p class="text-muted mb-0">Manage SSS, PhilHealth, Pag-IBIG settings and remittances</p>
    </div>
</div>

<!-- Compliance Status Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="pt-card h-100">
            <div class="pt-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 12px; background: #1a365d; display: flex; align-items: center; justify-content: center;">
                        <span class="text-white fw-bold">SSS</span>
                    </div>
                    <div>
                        <h5 class="mb-0">SSS</h5>
                        <span class="pt-badge pt-badge-success">Up to date</span>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Last Remittance</span>
                    <strong>Mar 10, 2026</strong>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Amount</span>
                    <strong>₱ 124,800</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-card h-100">
            <div class="pt-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 12px; background: #047857; display: flex; align-items: center; justify-content: center;">
                        <span class="text-white fw-bold">PH</span>
                    </div>
                    <div>
                        <h5 class="mb-0">PhilHealth</h5>
                        <span class="pt-badge pt-badge-success">Up to date</span>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Last Remittance</span>
                    <strong>Mar 10, 2026</strong>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Amount</span>
                    <strong>₱ 89,600</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-card h-100">
            <div class="pt-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 12px; background: #dc2626; display: flex; align-items: center; justify-content: center;">
                        <span class="text-white fw-bold small">HDMF</span>
                    </div>
                    <div>
                        <h5 class="mb-0">Pag-IBIG</h5>
                        <span class="pt-badge pt-badge-warning">Due in 5 days</span>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Next Due Date</span>
                    <strong>Apr 3, 2026</strong>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Amount Due</span>
                    <strong>₱ 29,600</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pt-card h-100">
            <div class="pt-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 12px; background: #7c3aed; display: flex; align-items: center; justify-content: center;">
                        <span class="text-white fw-bold">BIR</span>
                    </div>
                    <div>
                        <h5 class="mb-0">Withholding Tax</h5>
                        <span class="pt-badge pt-badge-success">Up to date</span>
                    </div>
                </div>
