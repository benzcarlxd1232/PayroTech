@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-1"><i class="bi bi-graph-up me-2"></i>Reports & Analytics</h4>
        <p class="text-muted mb-0">Comprehensive reporting and analytics dashboard</p>
    </div>
</div>

<div class="row g-4">
    <!-- Revenue Reports -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-cash-stack fs-1 text-primary mb-3"></i>
                <h5>Revenue Reports</h5>
                <p class="text-muted">Track subscription revenue and payment trends</p>
                <button class="btn btn-outline-primary" disabled>Coming Soon</button>
            </div>
        </div>
    </div>

    <!-- Company Analytics -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-building fs-1 text-success mb-3"></i>
                <h5>Company Analytics</h5>
                <p class="text-muted">Analyze company growth and engagement</p>
                <button class="btn btn-outline-success" disabled>Coming Soon</button>
            </div>
        </div>
    </div>

    <!-- Module Usage -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-grid fs-1 text-info mb-3"></i>
                <h5>Module Usage</h5>
                <p class="text-muted">Monitor module adoption and usage patterns</p>
                <button class="btn btn-outline-info" disabled>Coming Soon</button>
            </div>
        </div>
    </div>
</div>
