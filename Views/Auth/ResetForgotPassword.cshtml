@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Password - PayroTech</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --accent:#0891b2; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#0f172a,#1e3a5f); }
        .card { background:#fff; border-radius:16px; padding:40px 36px; width:100%; max-width:420px; box-shadow:0 20px 50px rgba(0,0,0,.4); }
        .icon-wrap { width:64px; height:64px; background:linear-gradient(135deg,#16a34a,#15803d); border-radius:16px; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:1.8rem; color:#fff; }
        h3 { font-size:1.4rem; font-weight:700; color:#0f172a; text-align:center; margin-bottom:6px; }
        .sub { font-size:.85rem; color:#64748b; text-align:center; margin-bottom:28px; line-height:1.5; }
        .form-label { font-size:.85rem; font-weight:600; color:#374151; margin-bottom:5px; }
        .input-wrap { position:relative; }
        .input-wrap .icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .input-wrap .eye { position:absolute; right:14px; top:50%; transform:translateY(-50%); color:#94a3b8; cursor:pointer; font-size:1rem; }
        .input-wrap input { width:100%; padding:11px 40px 11px 40px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:.9rem; outline:none; transition:border-color .2s; font-family:inherit; }
        .input-wrap input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(8,145,178,.1); }
        .btn-reset { width:100%; padding:12px; background:linear-gradient(135deg,var(--accent),#0e7490); color:#fff; border:none; border-radius:10px; font-size:.95rem; font-weight:600; cursor:pointer; margin-top:8px; transition:opacity .2s,transform .2s; }
        .btn-reset:hover { opacity:.92; transform:translateY(-1px); }
        .alert-err { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; border-radius:10px; padding:10px 14px; font-size:.85rem; margin-bottom:16px; }
        .verified-badge { background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:10px 14px; font-size:.82rem; color:#16a34a; margin-bottom:20px; text-align:center; }
        .req-list { font-size:.78rem; color:#64748b; margin-top:6px; padding-left:16px; }
        .req-list li { margin-bottom:2px; }
        .strength-bar { height:4px; border-radius:2px; background:#e2e8f0; margin-top:8px; overflow:hidden; }
        .strength-bar .fill { height:100%; border-radius:2px; transition:width .3s,background .3s; width:0; }
        .strength-label { font-size:.75rem; margin-top:4px; color:#94a3b8; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="bi bi-key"></i></div>
        <h3>Create New Password</h3>
        <p class="sub">Account: <strong>@email</strong><br>Set a new secure password for your account.</p>

        <div class="verified-badge">
            <i class="bi bi-patch-check-fill me-1"></i> Identity verified via OTP — you may now reset your password.
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-err">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-circle me-1"></i>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="ResetForgotPassword" asp-controller="Auth">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <div class="input-wrap">
                    <i class="bi bi-lock icon"></i>
                    <input type="password" name="newPassword" id="newPw" placeholder="Enter new password" required oninput="checkStrength()" />
                    <i class="bi bi-eye eye" id="eyeNew" onclick="togglePw('newPw','eyeNew')"></i>
                </div>
                <div class="strength-bar"><div class="fill" id="strengthFill"></div></div>
                <div class="strength-label" id="strengthLabel"></div>
                <ul class="req-list">
                    <li>At least 12 characters</li>
                    <li>Uppercase, lowercase, number, and special character</li>
                </ul>
            </div>

            <div class="mb-4">
                <label class="form-label">Confirm Password</label>
                <div class="input-wrap">
                    <i class="bi bi-lock-fill icon"></i>
                    <input type="password" name="confirmPassword" id="confirmPw" placeholder="Re-enter new password" required />
                    <i class="bi bi-eye eye" id="eyeConfirm" onclick="togglePw('confirmPw','eyeConfirm')"></i>
                </div>
                <div id="matchMsg" style="font-size:.78rem;margin-top:4px;"></div>
            </div>

            <button type="submit" class="btn-reset">
                <i class="bi bi-check-circle me-2"></i>Reset Password
            </button>
        </form>

        <div style="text-align:center;margin-top:20px;">
            <a href="/Auth/Login" style="font-size:.82rem;color:#94a3b8;text-decoration:none;">← Back to Sign In</a>
        </div>
    </div>

    <script>
        function togglePw(inputId, eyeId) {
            const i = document.getElementById(inputId);
            const e = document.getElementById(eyeId);
            if (i.type === 'password') { i.type = 'text'; e.className = 'bi bi-eye-slash eye'; }
            else { i.type = 'password'; e.className = 'bi bi-eye eye'; }
        }

        function checkStrength() {
            const pw = document.getElementById('newPw').value;
            const fill = document.getElementById('strengthFill');
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (pw.length >= 8) score++;
            if (pw.length >= 12) score++;
            if (/[A-Z]/.test(pw)) score++;
            if (/[a-z]/.test(pw)) score++;
            if (/[0-9]/.test(pw)) score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;

            const pct = Math.min(score / 6 * 100, 100);
            fill.style.width = pct + '%';

            if (score <= 2) { fill.style.background = '#dc2626'; label.textContent = 'Weak'; label.style.color = '#dc2626'; }
            else if (score <= 4) { fill.style.background = '#f59e0b'; label.textContent = 'Medium'; label.style.color = '#f59e0b'; }
            else { fill.style.background = '#16a34a'; label.textContent = 'Strong'; label.style.color = '#16a34a'; }

            if (!pw) { fill.style.width = '0'; label.textContent = ''; }
            checkMatch();
        }

        document.getElementById('confirmPw').addEventListener('input', checkMatch);
        function checkMatch() {
            const pw = document.getElementById('newPw').value;
            const cpw = document.getElementById('confirmPw').value;
            const msg = document.getElementById('matchMsg');
            if (!cpw) { msg.textContent = ''; return; }
            if (pw === cpw) { msg.textContent = '✓ Passwords match'; msg.style.color = '#16a34a'; }
            else { msg.textContent = '✗ Passwords do not match'; msg.style.color = '#dc2626'; }
        }
    </script>
</body>
</html>
