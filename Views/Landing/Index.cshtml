@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PayroTech - Smart Payroll & HR for Philippine Businesses</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary: #0f172a;
            --accent: #0891b2;
            --highlight: #22d3ee;
            --mid: #1e3a5f;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; color: #1e293b; }

        /* ── NAVBAR ── */
        .navbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: .85rem 0;
        }
        .navbar-brand { font-size: 1.4rem; font-weight: 700; color: var(--primary) !important; display: flex; align-items: center; gap: 8px; }
        .navbar-brand i { color: var(--accent); font-size: 1.7rem; }
        .nav-link { color: #475569 !important; font-weight: 500; padding: .4rem .9rem !important; }
        .nav-link:hover { color: var(--accent) !important; }
        .btn-signin { border: 1.5px solid var(--accent); color: var(--accent) !important; border-radius: 7px; padding: .4rem 1.1rem !important; font-weight: 600; }
        .btn-signin:hover { background: var(--accent); color: #fff !important; }
        .btn-getstarted { background: var(--accent); color: #fff !important; border-radius: 7px; padding: .4rem 1.2rem !important; font-weight: 600; }
        .btn-getstarted:hover { background: #0e7490; color: #fff !important; }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(135deg, var(--primary) 0%, var(--mid) 100%);
            color: #fff;
            padding: 100px 0 80px;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(ellipse at 70% 50%, rgba(34,211,238,.12) 0%, transparent 65%);
            pointer-events: none;
        }
        .hero-content { position: relative; z-index: 1; }
        .hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 1.2rem; }
        .hero h1 span { color: var(--highlight); }
        .hero .lead { font-size: 1.15rem; opacity: .9; max-width: 560px; margin-bottom: 2rem; }
        .btn-hero-white { background: #fff; color: var(--accent); font-weight: 700; border-radius: 8px; padding: .75rem 1.8rem; border: none; text-decoration: none; display: inline-block; transition: all .25s; }
        .btn-hero-white:hover { background: #e0f7fa; color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }
        .btn-hero-outline { background: transparent; color: #fff; font-weight: 700; border-radius: 8px; padding: .75rem 1.8rem; border: 2px solid rgba(255,255,255,.7); text-decoration: none; display: inline-block; transition: all .25s; }
        .btn-hero-outline:hover { background: rgba(255,255,255,.12); color: #fff; }
        .stat-badges { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.2rem; }
        .stat-badge { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff; border-radius: 50px; padding: .35rem 1rem; font-size: .82rem; font-weight: 500; backdrop-filter: blur(4px); }
        .stat-badge i { color: var(--highlight); margin-right: 4px; }
        .hero-visual { position: relative; z-index: 1; }
        .hero-card {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 16px;
            padding: 2rem;
            backdrop-filter: blur(8px);
        }
        .hero-card .metric { font-size: 2rem; font-weight: 800; color: var(--highlight); }
        .hero-card .metric-label { font-size: .8rem; opacity: .75; }

        /* ── FEATURES ── */
        .features { padding: 90px 0; background: #fff; }
        .section-label { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .5rem; }
        .section-title { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; color: var(--primary); margin-bottom: .75rem; }
        .section-sub { color: #64748b; font-size: 1.05rem; }
        .feature-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 2rem 1.6rem;
            height: 100%;
            transition: all .3s;
        }
        .feature-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(8,145,178,.12); border-color: var(--accent); }
        .feature-icon { width: 52px; height: 52px; background: linear-gradient(135deg, #e0f7fa, #b2ebf2); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.1rem; }
        .feature-icon i { font-size: 1.5rem; color: var(--accent); }
        .feature-card h5 { font-weight: 700; color: var(--primary); margin-bottom: .5rem; }
        .feature-card p { color: #64748b; font-size: .92rem; line-height: 1.6; margin: 0; }

        /* ── HOW IT WORKS ── */
        .how-it-works { padding: 90px 0; background: #f1f5f9; }
        .step-item { text-align: center; position: relative; }
        .step-number {
            width: 60px; height: 60px;
            background: var(--accent);
            color: #fff;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; font-weight: 800;
            margin: 0 auto 1rem;
            position: relative; z-index: 1;
        }
        .step-connector {
            position: absolute;
            top: 30px; left: calc(50% + 30px);
            width: calc(100% - 60px);
            height: 2px;
            background: linear-gradient(90deg, var(--accent), var(--highlight));
            z-index: 0;
        }
        .step-icon { font-size: 1.6rem; color: var(--accent); margin-bottom: .6rem; }
        .step-item h6 { font-weight: 700; color: var(--primary); margin-bottom: .4rem; }
        .step-item p { color: #64748b; font-size: .88rem; }

        /* ── PRICING ── */
        .pricing { padding: 90px 0; background: #fff; }
        .plan-card {
            border: 1.5px solid #e2e8f0;
            border-radius: 16px;
            padding: 2rem 1.6rem;
            height: 100%;
            position: relative;
            transition: all .3s;
        }
        .plan-card:hover { box-shadow: 0 16px 40px rgba(8,145,178,.12); border-color: var(--accent); }
        .plan-card.popular { border-color: var(--accent); box-shadow: 0 8px 32px rgba(8,145,178,.18); }
        .popular-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--accent); color: #fff; font-size: .75rem; font-weight: 700; padding: .25rem .9rem; border-radius: 50px; white-space: nowrap; }
        .plan-name { font-size: 1rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .4rem; }
        .plan-price { font-size: 2.2rem; font-weight: 800; color: var(--primary); line-height: 1; }
        .plan-price span { font-size: .95rem; font-weight: 500; color: #64748b; }
        .plan-features { list-style: none; padding: 0; margin: 1.2rem 0 1.6rem; }
        .plan-features li { padding: .35rem 0; font-size: .9rem; color: #475569; display: flex; align-items: center; gap: .5rem; }
        .plan-features li i { color: var(--accent); flex-shrink: 0; }
        .btn-plan { display: block; text-align: center; background: var(--accent); color: #fff; font-weight: 700; border-radius: 8px; padding: .7rem; text-decoration: none; transition: all .25s; }
        .btn-plan:hover { background: #0e7490; color: #fff; }
        .plan-card.popular .btn-plan { background: var(--primary); }
        .plan-card.popular .btn-plan:hover { background: #1e3a5f; }

        /* ── CTA ── */
        .cta-section { background: linear-gradient(135deg, var(--primary) 0%, var(--mid) 100%); padding: 80px 0; text-align: center; color: #fff; }
        .cta-section h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; margin-bottom: 1rem; }
        .cta-section p { opacity: .85; font-size: 1.05rem; margin-bottom: 2rem; }
        .btn-cta { background: var(--highlight); color: var(--primary); font-weight: 800; border-radius: 8px; padding: .85rem 2.2rem; text-decoration: none; display: inline-block; transition: all .25s; font-size: 1.05rem; }
        .btn-cta:hover { background: #67e8f9; color: var(--primary); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,0,0,.25); }

        /* ── FOOTER ── */
        footer { background: var(--primary); color: rgba(255,255,255,.7); padding: 40px 0; }
        footer .brand { color: #fff; font-weight: 700; font-size: 1.2rem; display: flex; align-items: center; gap: 6px; }
        footer .brand i { color: var(--highlight); }
        footer a { color: rgba(255,255,255,.6); text-decoration: none; font-size: .88rem; }
        footer a:hover { color: var(--highlight); }
        footer .footer-links { display: flex; gap: 1.4rem; flex-wrap: wrap; }

        /* ── KIOSK FAB ── */
        .kiosk-fab {
            position: fixed; bottom: 28px; right: 28px; z-index: 1050;
            width: 58px; height: 58px;
            background: var(--accent);
            color: #fff;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 6px 24px rgba(8,145,178,.45);
            text-decoration: none;
            transition: all .25s;
        }
        .kiosk-fab:hover { background: #0e7490; color: #fff; transform: scale(1.1); }
        .kiosk-fab-label {
            position: fixed; bottom: 36px; right: 96px; z-index: 1050;
            background: var(--primary); color: #fff;
            font-size: .78rem; font-weight: 600;
            padding: .3rem .75rem; border-radius: 6px;
            white-space: nowrap; pointer-events: none;
            opacity: 0; transition: opacity .2s;
        }
        .kiosk-fab:hover + .kiosk-fab-label { opacity: 1; }

        @@media (max-width: 768px) {
            .hero { padding: 70px 0 60px; }
            .step-connector { display: none; }
        }
    </style>
</head>
