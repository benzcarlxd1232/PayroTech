@using Microsoft.AspNetCore.Identity
@inject UserManager<PayroTech.Models.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Request New ID Card";
    var user = await UserManager.GetUserAsync(User);
    
    if (user?.Role == PayroTech.Models.Enums.UserRole.HR)
    {
        Layout = "~/Views/Shared/_HRLayout.cshtml";
    }
    else if (user?.Role == PayroTech.Models.Enums.UserRole.Accountant)
    {
        Layout = "~/Views/Shared/_AccountantLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    }
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="pt-card">
                <div class="pt-card-header">
                    <i class="bi bi-card-heading me-2"></i>Request New ID Card
                </div>
                <div class="pt-card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        </div>
                    }

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Important:</strong> ID card requests require manager approval. Please provide a clear reason for your request.
                    </div>

                    <form method="post" asp-action="Request">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason for Request <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="5" required 
                                      placeholder="Please explain why you need a new ID card (e.g., lost, damaged, stolen, etc.)" 
                                      minlength="10" maxlength="500"></textarea>
                            <small class="text-muted">Minimum 10 characters, maximum 500 characters</small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="@Url.Action("MyRequests")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>View My Requests
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-2"></i>Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
