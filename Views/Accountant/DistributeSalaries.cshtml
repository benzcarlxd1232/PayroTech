@{
    ViewData["Title"] = "Distribute Salaries";
    Layout = "~/Views/Shared/_AccountantLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Distribute Salaries</h4>
        <p class="text-muted mb-0">Distribute approved payrolls to employees</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-send fs-1 text-muted d-block mb-3"></i>
        <h5>Salary Distribution</h5>
        <p class="text-muted">Select approved payrolls from the pending list to distribute salaries.</p>
        <a href="/Accountant/PendingPayrolls" class="btn btn-warning mt-2">
            <i class="bi bi-hourglass-split me-2"></i>Go to Pending Payrolls
        </a>
    </div>
</div>
