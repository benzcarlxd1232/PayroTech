@model PayroTech.Models.Entities.VendorLog
@{
    ViewData["Title"] = "Transaction Receipt";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <a href="/SuperAdmin/TransactionLogs" class="btn btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Transactions
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Transaction Receipt</h5>
                    <button class="btn btn-sm btn-light" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Receipt Header -->
                <div class="text-center mb-4 pb-4 border-bottom">
                    <h3 class="text-primary">PayroTech System</h3>
                    <p class="text-muted mb-0">Vendor Transaction Receipt</p>
                    <small class="text-muted">Transaction ID: #@Model.Id</small>
                </div>

                <!-- Transaction Details -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">Transaction Information</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted">Date & Time:</td>
                                <td class="fw-bold">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Transaction Type:</td>
                                <td><span class="badge bg-primary">@Model.Action</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Status:</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">Entity Information</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted">Entity Type:</td>
                                <td class="fw-bold">@(Model.EntityType ?? "System")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Entity ID:</td>
                                <td>@(Model.EntityId ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Description:</td>
                                <td>@(Model.Description ?? "-")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Performed By -->
                <div class="mb-4">
                    <h6 class="text-muted mb-3">Performed By</h6>
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td class="text-muted" style="width: 150px;">Vendor:</td>
                            <td class="fw-bold">@(Model.Vendor?.FullName ?? Model.VendorName ?? "System")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Email:</td>
                            <td>@(Model.Vendor?.Email ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">IP Address:</td>
                            <td>@(Model.IpAddress ?? "-")</td>
                        </tr>
                    </table>
                </div>

                <!-- Transaction Details -->
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-4">
                        <h6 class="text-muted mb-3">Transaction Details</h6>
                        <div class="alert alert-light">
                            <pre class="mb-0" style="white-space: pre-wrap;">@Model.Description</pre>
                        </div>
                    </div>
                }

                <!-- Old/New Values -->
                @if (!string.IsNullOrEmpty(Model.OldValues) || !string.IsNullOrEmpty(Model.NewValues))
                {
                    <div class="mb-4">
                        <h6 class="text-muted mb-3">Changes</h6>
                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.OldValues))
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-light">
                                        <strong>Old Values:</strong>
                                        <pre class="mb-0 mt-2" style="white-space: pre-wrap;">@Model.OldValues</pre>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.NewValues))
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-light">
                                        <strong>New Values:</strong>
                                        <pre class="mb-0 mt-2" style="white-space: pre-wrap;">@Model.NewValues</pre>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Status -->
                <div class="mb-4">
                    <h6 class="text-muted mb-3">Status</h6>
                    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
                        <strong>@(Model.IsSuccess ? "Success" : "Failed")</strong>
                        @if (!Model.IsSuccess && !string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="mt-2">Error: @Model.ErrorMessage</div>
                        }
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mt-4 pt-4 border-top">
                    <p class="text-muted mb-1">This is a system-generated receipt</p>
                    <small class="text-muted">PayroTech Vendor Portal - © @DateTime.Now.Year</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Print styles
        window.addEventListener('beforeprint', function() {
            document.querySelector('.btn-outline-secondary').style.display = 'none';
        });
        
        window.addEventListener('afterprint', function() {
            document.querySelector('.btn-outline-secondary').style.display = 'block';
        });
    </script>
}

<style>
    @@media print {
        .sidebar, .top-navbar, .btn, nav { display: none !important; }
        .main-content { margin-left: 0 !important; }
        .card { border: none !important; box-shadow: none !important; }
    }
</style>
