@{
    Layout = null;
    var smtpEmail = ViewBag.SmtpEmail as string ?? "your email";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Code - PayroTech</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --accent:#0891b2; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#0f172a,#1e3a5f); }
        .card { background:#fff; border-radius:16px; padding:40px 36px; width:100%; max-width:420px; box-shadow:0 20px 50px rgba(0,0,0,.4); }
        .icon-wrap { width:64px; height:64px; background:linear-gradient(135deg,var(--accent),#0e7490); border-radius:16px; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:1.8rem; color:#fff; }
        h3 { font-size:1.4rem; font-weight:700; color:#0f172a; text-align:center; margin-bottom:6px; }
        .sub { font-size:.85rem; color:#64748b; text-align:center; margin-bottom:28px; }
        .otp-inputs { display:flex; gap:10px; justify-content:center; margin-bottom:24px; }
        .otp-inputs input { width:48px; height:56px; text-align:center; font-size:1.4rem; font-weight:700; border:2px solid #e2e8f0; border-radius:10px; outline:none; transition:border-color .2s; }
        .otp-inputs input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(8,145,178,.12); }
        .btn-verify { width:100%; padding:12px; background:linear-gradient(135deg,var(--accent),#0e7490); color:#fff; border:none; border-radius:10px; font-size:.95rem; font-weight:600; cursor:pointer; transition:opacity .2s; }
        .btn-verify:hover { opacity:.9; }
        .resend-row { text-align:center; margin-top:16px; font-size:.85rem; color:#64748b; }
        .resend-row button { background:none; border:none; color:var(--accent); font-weight:600; cursor:pointer; padding:0; }
        .resend-row button:disabled { color:#94a3b8; cursor:not-allowed; }
        .alert-err { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; border-radius:8px; padding:10px 14px; font-size:.85rem; margin-bottom:16px; }
        .back-link { display:block; text-align:center; margin-top:20px; font-size:.82rem; color:#94a3b8; text-decoration:none; }
        .back-link:hover { color:var(--accent); }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
        <h3>Two-Factor Verification</h3>
        <p class="sub">
            A 6-digit code has been sent to<br>
            <strong>@smtpEmail</strong><br>
            <span style="font-size:.78rem;color:#94a3b8;">Enter the code below to continue.</span>
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-err">
                <i class="bi bi-exclamation-circle me-1"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
            </div>
        }

        <form method="post" asp-action="VerifyOtp" id="otpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" id="codeHidden" />

            <div class="otp-inputs">
                @for (int i = 0; i < 6; i++)
                {
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="otp-digit" id="d@i" autocomplete="off" />
                }
            </div>

            <button type="submit" class="btn-verify" id="verifyBtn" disabled>
                <i class="bi bi-check-circle me-2"></i>Verify Code
            </button>
        </form>

        <div class="resend-row">
            Didn't receive it?
            <button id="resendBtn" onclick="resendCode()">Resend Code</button>
            <span id="countdown" style="display:none;color:#94a3b8;"></span>
        </div>

        <a href="/Auth/Login" class="back-link">← Back to Sign In</a>
    </div>

    <script>
        const digits = document.querySelectorAll('.otp-digit');
        const hidden = document.getElementById('codeHidden');
        const verifyBtn = document.getElementById('verifyBtn');

        digits.forEach((input, idx) => {
            input.addEventListener('input', e => {
                const val = e.target.value.replace(/\D/g, '');
                e.target.value = val;
                if (val && idx < 5) digits[idx + 1].focus();
                updateHidden();
            });
            input.addEventListener('keydown', e => {
                if (e.key === 'Backspace' && !e.target.value && idx > 0)
                    digits[idx - 1].focus();
            });
            input.addEventListener('paste', e => {
                e.preventDefault();
                const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                pasted.split('').forEach((ch, i) => { if (digits[i]) digits[i].value = ch; });
                updateHidden();
                if (pasted.length === 6) verifyBtn.focus();
            });
        });

        function updateHidden() {
            const code = Array.from(digits).map(d => d.value).join('');
            hidden.value = code;
            verifyBtn.disabled = code.length < 6;
        }

        // Auto-focus first digit
        digits[0].focus();

        // Resend with 60-second cooldown
        let cooldown = 0;
        function resendCode() {
            const btn = document.getElementById('resendBtn');
            const cd  = document.getElementById('countdown');
            btn.disabled = true;
            cooldown = 60;
            cd.style.display = 'inline';

            fetch('/Auth/ResendOtp', { method:'POST', headers:{'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? ''} })
                .then(() => {
                    const timer = setInterval(() => {
                        cooldown--;
                        cd.textContent = ` (${cooldown}s)`;
                        if (cooldown <= 0) {
                            clearInterval(timer);
                            btn.disabled = false;
                            cd.style.display = 'none';
                        }
                    }, 1000);
                });
        }
    </script>
</body>
</html>
