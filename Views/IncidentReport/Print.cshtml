@model PayroTech.Models.Entities.IncidentReport
@{
    ViewData["Title"] = "Incident Report";
    Layout = null;
    var companyName = Model.ReportedBy?.Company?.CompanyName ?? "PayroTech";
    var reporterName = Model.ReportedBy?.FullName ?? "—";
    var reviewerName = Model.AssignedTo?.FullName ?? "Manager / HR";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Incident Report #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        @@media print {
            .no-print { display:none !important; }
            body { margin:0; padding:0; }
        }
        * { box-sizing:border-box; }
        body { font-family:'Segoe UI',Arial,sans-serif; background:#f0f0f0; padding:30px 20px; }
        .doc { max-width:720px; margin:0 auto; background:#fff; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.12); overflow:hidden; }
        .doc-header { background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; padding:28px 32px; }
        .doc-header h2 { margin:0 0 4px; font-size:1.4rem; font-weight:700; }
        .doc-header p { margin:0; opacity:.85; font-size:.875rem; }
        .doc-body { padding:28px 32px; }
        .field-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
        .field { }
        .field .lbl { font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#6b7280; font-weight:600; margin-bottom:4px; }
        .field .val { font-size:.95rem; color:#111827; font-weight:500; border-bottom:1px solid #e5e7eb; padding-bottom:4px; min-height:28px; }
        .field.full { grid-column:1/-1; }
        .section-title { font-size:.8rem; text-transform:uppercase; letter-spacing:.8px; color:#ef4444; font-weight:700; margin:20px 0 12px; border-bottom:2px solid #fecaca; padding-bottom:4px; }
        .sig-row { display:grid; grid-template-columns:1fr 1fr; gap:32px; margin-top:32px; }
        .sig-box { border-top:2px solid #374151; padding-top:8px; }
        .sig-box .name { font-size:.85rem; font-weight:600; }
        .sig-box .role { font-size:.75rem; color:#6b7280; }
        .doc-footer { background:#f9fafb; border-top:1px solid #e5e7eb; padding:12px 32px; font-size:.75rem; color:#9ca3af; text-align:center; }
        .badge-type { display:inline-block; background:#fef2f2; color:#ef4444; border:1px solid #fecaca; border-radius:20px; padding:3px 12px; font-size:.8rem; font-weight:600; }
        .actions { text-align:center; margin:24px 0 8px; }
        .btn-dl { background:#ef4444; color:#fff; border:none; padding:11px 32px; border-radius:8px; font-size:15px; font-weight:600; cursor:pointer; transition:all .2s; }
        .btn-dl:hover { background:#dc2626; transform:translateY(-1px); }
    </style>
</head>
<body>
<div class="doc">
    <div class="doc-header">
        <h2><i class="bi bi-exclamation-triangle-fill me-2"></i>Incident Report</h2>
        <p>@companyName &nbsp;|&nbsp; Report #@Model.Id &nbsp;|&nbsp; @Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</p>
    </div>

    <div class="doc-body">
        <div class="field-row">
            <div class="field">
                <div class="lbl">Incident Type</div>
                <div class="val"><span class="badge-type">@Model.Title</span></div>
            </div>
            <div class="field">
                <div class="lbl">Date & Time of Incident</div>
                <div class="val">@(Model.WhenHappened?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</div>
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <div class="lbl">Reported By</div>
                <div class="val">@reporterName</div>
            </div>
            <div class="field">
                <div class="lbl">To Be Reviewed By</div>
                <div class="val">@reviewerName</div>
            </div>
        </div>

        <div class="section-title">Incident Details</div>

        <div class="field full" style="margin-bottom:16px;">
            <div class="lbl">What Happened</div>
            <div class="val" style="min-height:60px;white-space:pre-wrap;">@Model.WhatHappened</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.WhyHappened))
        {
            <div class="field full" style="margin-bottom:16px;">
                <div class="lbl">Why It Happened</div>
                <div class="val" style="min-height:40px;white-space:pre-wrap;">@Model.WhyHappened</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="field full" style="margin-bottom:16px;">
                <div class="lbl">Additional Notes</div>
                <div class="val" style="min-height:40px;white-space:pre-wrap;">@Model.Description</div>
            </div>
        }

        <div class="section-title">Signatures</div>
        <div class="sig-row">
            <div class="sig-box">
                <div style="height:48px;"></div>
                <div class="name">@reporterName</div>
                <div class="role">Reporter</div>
            </div>
            <div class="sig-box">
                <div style="height:48px;"></div>
                <div class="name">@reviewerName</div>
                <div class="role">Reviewer / Approver</div>
            </div>
        </div>
    </div>

    <div class="doc-footer">
        This document is generated by PayroTech ERP. Print and submit physically to your reviewer.
    </div>
</div>

<div class="actions no-print">
    <div class="mb-3">
        <a href="/IncidentReport/MyReports" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Reports
        </a>
    </div>
    <button class="btn-dl" onclick="downloadReport()">
        <i class="bi bi-download me-2"></i>Download / Print Report
    </button>
    <p style="color:#6b7280;font-size:13px;margin-top:10px;">
        After downloading, hand this document to <strong>@reviewerName</strong>.
    </p>
    <a href="@Url.Action("MyReports", "IncidentReport")" style="color:#6b7280;font-size:13px;">
        ← Back to My Reports
    </a>
</div>

<script>
function downloadReport() {
    window.print();
    // After print dialog closes, redirect to dashboard
    setTimeout(() => { window.location.href = '/'; }, 2000);
}
</script>
</body>
</html>
