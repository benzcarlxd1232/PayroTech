@{
    ViewData["Title"] = "Process Payroll";
    Layout = "~/Views/Shared/_AccountantLayout.cshtml";
    var periods        = ViewBag.Periods        as List<PayroTech.Models.Entities.PayrollPeriod> ?? new();
    var selectedPeriod = ViewBag.SelectedPeriod as PayroTech.Models.Entities.PayrollPeriod;
    var payrolls       = ViewBag.Payrolls       as List<PayroTech.Models.Entities.Payroll> ?? new();
    decimal totalGross = ViewBag.TotalGross     ?? 0m;
    decimal totalNet   = ViewBag.TotalNet       ?? 0m;
    decimal totalDeduct= ViewBag.TotalDeduct    ?? 0m;
    decimal totalSSS   = ViewBag.TotalSSS       ?? 0m;
    decimal totalPH    = ViewBag.TotalPhilHealth?? 0m;
    decimal totalPI    = ViewBag.TotalPagIbig   ?? 0m;
    decimal totalTax   = ViewBag.TotalTax       ?? 0m;
    decimal totalLate  = ViewBag.TotalLate      ?? 0m;
    decimal totalAbs   = ViewBag.TotalAbsence   ?? 0m;
    decimal totalOT    = ViewBag.TotalOT        ?? 0m;
    decimal totalHol   = ViewBag.TotalHoliday   ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Process Payroll</h4>
        <p class="text-muted mb-0">Review payroll details before distributing salaries</p>
    </div>
    @if (selectedPeriod != null && payrolls.Any())
    {
        <a href="/Accountant/PendingPayrolls" class="pt-btn pt-btn-success">
            <i class="bi bi-send-check me-2"></i>Go to Distribution
        </a>
    }
</div>

@if (!periods.Any())
{
    <div class="pt-card">
        <div class="pt-card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h6>No payrolls pending review</h6>
            <p class="text-muted small">Payrolls submitted by HR and approved by the Manager will appear here.</p>
        </div>
    </div>
}
else
{
    <!-- Period Selector -->
    <div class="pt-card mb-4">
        <div class="pt-card-body">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <label class="fw-semibold mb-0">Select Period:</label>
                @foreach (var p in periods)
                {
                    var isSelected = selectedPeriod?.Id == p.Id;
                    <a href="/Accountant/ProcessPayroll?periodId=@p.Id"
                       class="btn @(isSelected ? "btn-primary" : "btn-outline-secondary") btn-sm">
                        @p.PeriodName
                        <span class="badge @(p.Status == PayroTech.Models.Enums.PayrollStatus.Approved ? "bg-success" : "bg-warning text-dark") ms-1">
                            @p.Status
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>

    @if (selectedPeriod != null)
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="pt-stats-card">
                    <div class="pt-stats-value">@payrolls.Count</div>
                    <div class="pt-stats-label">Employees</div>
                    <i class="bi bi-people pt-stats-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pt-stats-card success">
                    <div class="pt-stats-value" style="font-size:1.3rem;">₱@totalNet.ToString("N0")</div>
                    <div class="pt-stats-label">Total Net Pay</div>
                    <i class="bi bi-cash-stack pt-stats-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pt-stats-card warning">
                    <div class="pt-stats-value" style="font-size:1.3rem;">₱@totalOT.ToString("N0")</div>
                    <div class="pt-stats-label">Total Overtime</div>
                    <i class="bi bi-clock-history pt-stats-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pt-stats-card danger">
                    <div class="pt-stats-value" style="font-size:1.3rem;">₱@totalDeduct.ToString("N0")</div>
                    <div class="pt-stats-label">Total Deductions</div>
                    <i class="bi bi-dash-circle pt-stats-icon"></i>
                </div>
            </div>
        </div>

        <!-- Full Payroll Breakdown Table -->
        <div class="pt-card mb-4">
            <div class="pt-card-header">
                <i class="bi bi-table me-2"></i>Full Payroll Breakdown — @selectedPeriod.PeriodName
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Employee</th>
                            <th class="text-center">Dept</th>
                            <th class="text-center">Days</th>
                            <th class="text-end">Basic</th>
                            <th class="text-end text-success">OT</th>
                            <th class="text-end text-warning">Holiday</th>
                            <th class="text-end text-danger">Late</th>
                            <th class="text-end text-danger">Absent</th>
                            <th class="text-end text-danger">SSS</th>
                            <th class="text-end text-danger">PhilHealth</th>
                            <th class="text-end text-danger">Pag-IBIG</th>
                            <th class="text-end text-danger">Tax</th>
                            <th class="text-end fw-bold text-success">Net Pay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in payrolls)
                        {
                            var hasIssue = p.LateDeduction > 0 || p.AbsenceDeduction > 0 || p.UndertimeDeduction > 0;
                            <tr class="@(hasIssue ? "table-warning" : "")">
                                <td class="ps-3 fw-medium">@p.Employee?.FullName</td>
                                <td class="text-center text-muted">@(p.Employee?.Department?.DepartmentName ?? "—")</td>
                                <td class="text-center">@p.DaysWorked.ToString("N1")</td>
                                <td class="text-end">₱@p.BasicPay.ToString("N2")</td>
                                <td class="text-end text-success">₱@p.OvertimePay.ToString("N2")</td>
                                <td class="text-end text-warning">₱@p.HolidayPay.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.LateDeduction.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.AbsenceDeduction.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.SSSContribution.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.PhilHealthContribution.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.PagIbigContribution.ToString("N2")</td>
                                <td class="text-end text-danger">-₱@p.WithholdingTax.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₱@p.NetPay.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="3" class="ps-3">TOTAL</td>
                            <td class="text-end">₱@payrolls.Sum(p => p.BasicPay).ToString("N2")</td>
                            <td class="text-end text-success">₱@totalOT.ToString("N2")</td>
                            <td class="text-end text-warning">₱@totalHol.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalLate.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalAbs.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalSSS.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalPH.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalPI.ToString("N2")</td>
                            <td class="text-end text-danger">-₱@totalTax.ToString("N2")</td>
                            <td class="text-end text-success">₱@totalNet.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Government Deductions Summary -->
        <div class="pt-card mb-4">
            <div class="pt-card-header"><i class="bi bi-bank me-2"></i>Government Contributions Summary</div>
            <div class="pt-card-body">
                <div class="row text-center">
                    <div class="col-md-3 border-end">
                        <div class="text-muted small mb-1">SSS</div>
                        <h5 class="text-danger">₱@totalSSS.ToString("N2")</h5>
                        <small class="text-muted">4.5% of gross (max ₱900)</small>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small mb-1">PhilHealth</div>
                        <h5 class="text-danger">₱@totalPH.ToString("N2")</h5>
                        <small class="text-muted">2.5% of gross (max ₱625)</small>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small mb-1">Pag-IBIG</div>
                        <h5 class="text-danger">₱@totalPI.ToString("N2")</h5>
                        <small class="text-muted">2% of gross (max ₱200)</small>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small mb-1">Withholding Tax</div>
                        <h5 class="text-danger">₱@totalTax.ToString("N2")</h5>
                        <small class="text-muted">BIR graduated rate</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action -->
        <div class="d-flex justify-content-end gap-3">
            <a href="/Accountant/PendingPayrolls" class="pt-btn pt-btn-success pt-btn-lg">
                <i class="bi bi-send-check me-2"></i>Proceed to Salary Distribution
            </a>
        </div>
    }
}
