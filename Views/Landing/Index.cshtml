                    <p>Control user permissions with fine-grained role and department-level access</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h3>Continuous Support</h3>
                    <p>Dedicated support team and regular system updates with new features</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta" id="contact">
        <div class="container-lg">
            <h2>Ready to Transform Your Workforce Management?</h2>
            <p>Join hundreds of companies that trust PayroTech for their HR and payroll needs</p>
            <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
                <a href="/Auth/Login" class="btn btn-hero btn-hero-primary" style="background: #0891b2; color: white; border: none;">Sign In Now</a>
                <a href="#home" class="btn btn-hero btn-hero-secondary" style="background: transparent; color: #0891b2; border: 2px solid #0891b2;">Contact Us</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container-lg">
            <p>&copy; 2026 PayroTech ERP System. All rights reserved.</p>
            <p style="margin-top: 10px; font-size: 0.9rem;">Enterprise Payroll & HR Management Solution</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
