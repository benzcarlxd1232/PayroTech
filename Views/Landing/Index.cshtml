                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <h3>Department Organization</h3>
                    <p>Organize employees by departments with clear hierarchies and reporting structures</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>
                    <h3>Advanced Analytics</h3>
                    <p>Comprehensive reports and insights on payroll, attendance, and workforce metrics</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats" id="about">
        <div class="container-lg">
            <div class="stats-grid">
                <div class="stat-item">
                    <h3>10K+</h3>
                    <p>Employees Managed</p>
                </div>
                <div class="stat-item">
                    <h3>500+</h3>
                    <p>Companies Using</p>
                </div>
                <div class="stat-item">
                    <h3>99.9%</h3>
                    <p>System Uptime</p>
                </div>
                <div class="stat-item">
                    <h3>24/7</h3>
                    <p>Support Available</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="features">
        <div class="container-lg">
            <div class="section-title">
                <h2>Why Choose PayroTech?</h2>
                <p>Industry-leading solution for modern workforce management</p>
            </div>
            <div class="feature-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-cloud"></i>
                    </div>
                    <h3>Cloud-Based</h3>
                    <p>Access your data anytime, anywhere with our secure cloud infrastructure</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3>Secure & Compliant</h3>
                    <p>Enterprise-grade security with compliance to international standards</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
