@{
    ViewData["Title"] = "Payroll";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
    var periods      = ViewBag.Periods      as List<PayroTech.Models.Entities.PayrollPeriod> ?? new();
    var payrollItems = ViewBag.PayrollItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var totalNet     = (decimal)(ViewBag.TotalNetPay   ?? 0m);
    var totalGross   = (decimal)(ViewBag.TotalBasicPay ?? 0m) + (decimal)(ViewBag.TotalOtPay ?? 0m);
    var totalDeduct  = (decimal)(ViewBag.TotalDeduct   ?? 0m);
    var periodLabel  = ViewBag.PeriodLabel as string ?? DateTime.Today.ToString("MMMM yyyy");
    var alreadySubmitted = (bool)(ViewBag.AlreadySubmitted ?? false);
    var existingStatus   = ViewBag.ExistingStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Payroll Preparation</h4>
        <p class="text-muted mb-0">Review payroll for <strong>@periodLabel</strong></p>
    </div>
    <div class="d-flex gap-2">
        @if (!alreadySubmitted && payrollItems.Any())
        {
            <a href="/HR/SubmitPayroll" class="pt-btn pt-btn-primary">
                <i class="bi bi-send me-2"></i>Submit for Approval
            </a>
        }
        else if (alreadySubmitted)
        {
            <span class="pt-badge pt-badge-success fs-6 px-3 py-2">
                <i class="bi bi-check-circle me-1"></i>Submitted — @existingStatus
            </span>
        }
    </div>
</div>

@if (alreadySubmitted)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle me-2"></i>
        Payroll for <strong>@periodLabel</strong> has been submitted (Status: <strong>@existingStatus</strong>).
        <a href="/HR/SubmitPayroll" class="alert-link ms-2">View submission →</a>
    </div>
}

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="pt-stats-card">
            <div class="pt-stats-value">@payrollItems.Count()</div>
            <div class="pt-stats-label">Employees</div>
            <i class="bi bi-people pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pt-stats-card success">
            <div class="pt-stats-value" style="font-size:1.4rem;">₱@totalNet.ToString("N0")</div>
            <div class="pt-stats-label">Total Net Pay</div>
            <i class="bi bi-cash-stack pt-stats-icon"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pt-stats-card danger">
            <div class="pt-stats-value" style="font-size:1.4rem;">₱@totalDeduct.ToString("N0")</div>
            <div class="pt-stats-label">Total Deductions</div>
            <i class="bi bi-dash-circle pt-stats-icon"></i>
        </div>
    </div>
</div>

<!-- Payroll Table -->
<div class="pt-card">
    <div class="pt-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Payroll Breakdown — @periodLabel</span>
        <a href="/HR/SubmitPayroll" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye me-1"></i>Full Preview & Submit
        </a>
    </div>
    @if (!payrollItems.Any())
    {
        <div class="pt-card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h6>No payroll data yet</h6>
            <p class="text-muted small">Attendance records for this month will appear here once employees clock in.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="pt-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th class="text-center">Days</th>
                        <th class="text-center">OT hrs</th>
                        <th class="text-end">Basic Pay</th>
                        <th class="text-end">OT Pay</th>
                        <th class="text-end text-danger">Deductions</th>
                        <th class="text-end text-success">Net Pay</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in payrollItems)
                    {
                        var hasDeduct = (decimal)item.LateDeduct > 0 || (decimal)item.AbsenceDeduct > 0 || (decimal)item.UndertimeDeduct > 0;
                        <tr class="@(hasDeduct ? "table-warning" : "")">
                            <td class="fw-medium">@item.FullName</td>
                            <td class="text-center">@item.DaysWorked</td>
                            <td class="text-center">@item.OtHours</td>
                            <td class="text-end">₱@((decimal)item.BasicPay).ToString("N2")</td>
                            <td class="text-end text-success">₱@((decimal)item.OtPay).ToString("N2")</td>
                            <td class="text-end text-danger">-₱@((decimal)item.TotalDeduct).ToString("N2")</td>
                            <td class="text-end fw-bold text-success">₱@((decimal)item.NetPay).ToString("N2")</td>
                            <td class="text-center">
                                @if (hasDeduct)
                                {
                                    <span class="pt-badge pt-badge-warning">Has Deductions</span>
                                }
                                else
                                {
                                    <span class="pt-badge pt-badge-success">Complete</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="3">TOTAL (@payrollItems.Count() employees)</td>
                        <td class="text-end">₱@((decimal)(ViewBag.TotalBasicPay ?? 0m)).ToString("N2")</td>
                        <td class="text-end text-success">₱@((decimal)(ViewBag.TotalOtPay ?? 0m)).ToString("N2")</td>
                        <td class="text-end text-danger">-₱@totalDeduct.ToString("N2")</td>
                        <td class="text-end text-success">₱@totalNet.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<!-- Government Deductions Summary -->
@if (payrollItems.Any())
{
    <div class="pt-card mt-4">
        <div class="pt-card-header"><i class="bi bi-bank me-2"></i>Government Deductions Summary</div>
        <div class="pt-card-body">
            <div class="row text-center">
                <div class="col-md-3 border-end">
                    <div class="text-muted small mb-1">SSS</div>
                    <h5>₱@((decimal)(ViewBag.TotalSss ?? 0m)).ToString("N2")</h5>
                </div>
                <div class="col-md-3 border-end">
                    <div class="text-muted small mb-1">PhilHealth</div>
                    <h5>₱@((decimal)(ViewBag.TotalPhilHealth ?? 0m)).ToString("N2")</h5>
                </div>
                <div class="col-md-3 border-end">
                    <div class="text-muted small mb-1">Pag-IBIG</div>
                    <h5>₱@((decimal)(ViewBag.TotalPagIbig ?? 0m)).ToString("N2")</h5>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Withholding Tax</div>
                    <h5>₱@((decimal)(ViewBag.TotalTax ?? 0m)).ToString("N2")</h5>
                </div>
            </div>
        </div>
    </div>
}
