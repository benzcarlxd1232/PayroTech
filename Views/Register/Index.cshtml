@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Your Company - PayroTech</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --accent:#0891b2; --accent-dark:#0e7490; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; background:#f1f5f9; min-height:100vh; }
        .top-bar { background:#fff; border-bottom:1px solid #e2e8f0; padding:.85rem 0; }
        .brand { font-size:1.3rem; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:8px; text-decoration:none; }
        .brand i { color:var(--accent); font-size:1.5rem; }
        .page-header { background:linear-gradient(135deg,#0f172a,#1e3a5f,#0891b2); color:#fff; padding:48px 0 40px; text-align:center; }
        .page-header h1 { font-size:2rem; font-weight:700; margin-bottom:8px; }
        .page-header p  { opacity:.85; font-size:1rem; }
        /* Stepper */
        .stepper { display:flex; justify-content:center; gap:0; margin:32px 0 0; }
        .step { display:flex; align-items:center; gap:8px; font-size:.82rem; font-weight:600; opacity:.5; }
        .step.active { opacity:1; }
        .step.done   { opacity:.8; }
        .step-num { width:28px; height:28px; border-radius:50%; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; font-size:.8rem; flex-shrink:0; }
        .step.active .step-num { background:#fff; color:var(--accent); }
        .step.done   .step-num { background:rgba(255,255,255,.9); color:#059669; }
        .step-line { width:48px; height:2px; background:rgba(255,255,255,.2); margin:0 4px; }
        /* Card */
        .reg-card { background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.08); padding:36px 40px; margin-bottom:24px; }
        .section-label { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--accent); margin-bottom:16px; display:flex; align-items:center; gap:8px; }
        .form-label { font-size:.85rem; font-weight:600; color:#374151; margin-bottom:5px; }
        .form-control, .form-select { border:1.5px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:.9rem; transition:border-color .2s; }
        .form-control:focus, .form-select:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(8,145,178,.1); outline:none; }
        /* Plan cards */
        .plan-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; }
        .plan-card { border:2px solid #e2e8f0; border-radius:12px; padding:18px 16px; cursor:pointer; transition:all .2s; position:relative; }
        .plan-card:hover { border-color:var(--accent); }
        .plan-card.selected { border-color:var(--accent); background:#f0f9ff; }
        .plan-card input[type=radio] { position:absolute; opacity:0; }
        .plan-name  { font-weight:700; font-size:.95rem; color:#0f172a; margin-bottom:4px; }
        .plan-price { font-size:1.3rem; font-weight:800; color:var(--accent); }
        .plan-price span { font-size:.75rem; font-weight:400; color:#64748b; }
        .plan-badge { position:absolute; top:-10px; right:12px; background:var(--accent); color:#fff; font-size:.65rem; font-weight:700; padding:2px 10px; border-radius:20px; }
        /* Summary */
        .summary-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:20px; }
        .summary-row { display:flex; justify-content:space-between; padding:6px 0; font-size:.88rem; border-bottom:1px solid #f1f5f9; }
        .summary-row:last-child { border-bottom:none; font-weight:700; font-size:1rem; color:var(--accent); }
        /* Buttons */
        .btn-next { background:linear-gradient(135deg,var(--accent),var(--accent-dark)); color:#fff; border:none; border-radius:10px; padding:12px 32px; font-weight:600; font-size:.95rem; cursor:pointer; transition:opacity .2s; }
        .btn-next:hover { opacity:.9; }
        .btn-back { background:#f1f5f9; color:#374151; border:none; border-radius:10px; padding:12px 24px; font-weight:600; font-size:.9rem; cursor:pointer; }
        /* Payment modal */
        .modal-content { border-radius:16px; border:none; }
        .modal-header { background:linear-gradient(135deg,var(--accent),var(--accent-dark)); color:#fff; border-radius:16px 16px 0 0; }
        .modal-header .btn-close { filter:invert(1); }
        /* Steps */
        .step-content { display:none; }
        .step-content.active { display:block; }
        /* Online badge */
        .online-only-badge { background:#fef3c7; border:1px solid #fde68a; color:#92400e; border-radius:8px; padding:10px 16px; font-size:.85rem; margin-bottom:20px; }
    </style>
</head>
<body>

<div class="top-bar">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <a href="/" class="brand"><i class="bi bi-graph-up-arrow"></i>PayroTech</a>
            <a href="/Auth/Login" class="btn btn-sm btn-outline-secondary">Already have an account? Sign In</a>
        </div>
    </div>
</div>

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-building-add me-2"></i>Register Your Company</h1>
        <p>Get started with PayroTech — complete setup in minutes, pay securely online</p>
        <div class="stepper">
            <div class="step active" id="s1"><div class="step-num">1</div><span>Company Info</span></div>
            <div class="step-line"></div>
            <div class="step" id="s2"><div class="step-num">2</div><span>Manager Account</span></div>
            <div class="step-line"></div>
            <div class="step" id="s3"><div class="step-num">3</div><span>Choose Plan</span></div>
            <div class="step-line"></div>
            <div class="step" id="s4"><div class="step-num">4</div><span>Payment</span></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="container py-4" style="max-width:760px;">

    <!-- STEP 1: Company Info -->
    <div class="step-content active" id="step1">
        <div class="reg-card">
            <div class="section-label"><i class="bi bi-building"></i>Company Information</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Company Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="companyName" placeholder="e.g. ABC Corporation">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Industry Type <span class="text-danger">*</span></label>
                    <select class="form-select" id="industryType">
                        <option value="">Select Industry</option>
                        <option>Technology & IT</option><option>Healthcare & Medical</option>
                        <option>Education & Training</option><option>Retail & E-commerce</option>
                        <option>Manufacturing</option><option>Construction & Real Estate</option>
                        <option>Finance & Banking</option><option>Food & Beverage</option>
                        <option>Transportation & Logistics</option><option>Hospitality & Tourism</option>
                        <option>Professional Services</option><option>Agriculture</option>
                        <option>Government & Public Sector</option><option>Non-Profit & NGO</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Company Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="companyEmail" placeholder="info@company.com">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact Number</label>
                    <input type="tel" class="form-control" id="contactNumber" placeholder="+63 9XX XXX XXXX">
                </div>
                <div class="col-12">
                    <label class="form-label">Company Address</label>
                    <input type="text" class="form-control" id="companyAddress" placeholder="Building, Street, City, Province">
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end">
            <button class="btn-next" onclick="goStep(2)">Continue <i class="bi bi-arrow-right ms-2"></i></button>
        </div>
    </div>

    <!-- STEP 2: Manager Account -->
    <div class="step-content" id="step2">
        <div class="reg-card">
            <div class="section-label"><i class="bi bi-person-badge"></i>Manager Account</div>
            <p class="text-muted small mb-4">This will be the primary administrator for your company. A temporary password will be sent to their email after payment.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="adminFirst" placeholder="First name">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="adminLast" placeholder="Last name">
                </div>
                <div class="col-12">
                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="adminEmail" placeholder="manager@company.com">
                    <div class="form-text">This will be your login username. Credentials will be emailed after payment.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact Number <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="adminContact" placeholder="+63 9XX XXX XXXX">
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between">
            <button class="btn-back" onclick="goStep(1)"><i class="bi bi-arrow-left me-2"></i>Back</button>
            <button class="btn-next" onclick="goStep(3)">Continue <i class="bi bi-arrow-right ms-2"></i></button>
        </div>
    </div>

    <!-- STEP 3: Plan Selection -->
    <div class="step-content" id="step3">
        <div class="reg-card">
            <div class="section-label"><i class="bi bi-credit-card"></i>Choose Your Plan</div>

            <div class="online-only-badge">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Online Registration</strong> — Payment is processed securely via PayMongo (GCash, Maya, Credit/Debit Card).
            </div>

            <div class="d-flex gap-2 mb-4">
                <button class="btn btn-sm btn-outline-primary active" id="btnMonthly" onclick="setBilling('monthly')">Monthly</button>
                <button class="btn btn-sm btn-outline-secondary" id="btnYearly" onclick="setBilling('yearly')">Yearly <span class="badge bg-success ms-1">Save 17%</span></button>
            </div>

            <div class="plan-grid mb-4">
                <label class="plan-card selected" onclick="selectPlan(1,this)">
                    <input type="radio" name="plan" value="1" checked>
                    <div class="plan-name">Basic</div>
                    <div class="plan-price" id="p1">₱2,999<span>/mo</span></div>
                    <div class="text-muted small mt-2">Up to 20 employees</div>
                </label>
                <label class="plan-card" onclick="selectPlan(2,this)">
                    <input type="radio" name="plan" value="2">
                    <div class="plan-name">Standard</div>
                    <div class="plan-price" id="p2">₱4,999<span>/mo</span></div>
                    <div class="text-muted small mt-2">Up to 50 employees</div>
                </label>
                <label class="plan-card" onclick="selectPlan(3,this)">
                    <input type="radio" name="plan" value="3">
                    <div class="plan-badge">POPULAR</div>
                    <div class="plan-name">Professional</div>
                    <div class="plan-price" id="p3">₱7,999<span>/mo</span></div>
                    <div class="text-muted small mt-2">Up to 150 employees</div>
                </label>
                <label class="plan-card" onclick="selectPlan(4,this)">
                    <input type="radio" name="plan" value="4">
                    <div class="plan-name">Enterprise</div>
                    <div class="plan-price" id="p4">₱12,999<span>/mo</span></div>
                    <div class="text-muted small mt-2">Unlimited employees</div>
                </label>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Number of Kiosks</label>
                    <select class="form-select" id="kioskCount" onchange="updateSummary()">
                        <option value="1">1 Kiosk (+₱2,500/mo)</option>
                        <option value="2">2 Kiosks (+₱5,000/mo)</option>
                        <option value="3">3 Kiosks (+₱7,500/mo)</option>
                    </select>
                </div>
            </div>

            <div class="summary-box">
                <div class="summary-row"><span>Plan</span><span id="sumPlan">Basic — Monthly</span></div>
                <div class="summary-row"><span>Plan Price</span><span id="sumPlanPrice">₱2,999.00</span></div>
                <div class="summary-row"><span>Kiosk Cost</span><span id="sumKiosk">₱2,500.00</span></div>
                <div class="summary-row"><span>Total Amount</span><span id="sumTotal">₱5,499.00</span></div>
            </div>
        </div>
        <div class="d-flex justify-content-between">
            <button class="btn-back" onclick="goStep(2)"><i class="bi bi-arrow-left me-2"></i>Back</button>
            <button class="btn-next" onclick="proceedToPayment()" id="payBtn">
                <i class="bi bi-lock me-2"></i>Proceed to Payment
            </button>
        </div>
    </div>

    <!-- STEP 4: Payment (shown after payment modal) -->
    <div class="step-content" id="step4">
        <div class="reg-card text-center py-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>
            <h4 class="mt-3 mb-2">Payment Confirmed!</h4>
            <p class="text-muted mb-4">Your company has been registered. Check your email for login credentials.</p>
            <a href="/Auth/Login" class="btn-next" style="text-decoration:none;display:inline-block;">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In Now
            </a>
        </div>
    </div>

</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-credit-card me-2"></i>Complete Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between">
                    <span class="text-muted small">Reference:</span>
                    <strong id="payRef" class="small"></strong>
                </div>
                <iframe id="payFrame" style="width:100%;height:520px;border:none;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmPayBtn" onclick="confirmPayment()">
                    <i class="bi bi-check-circle me-1"></i>I have completed payment
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const PLANS = {
        1: { name:"Basic",        monthly:2999,  yearly:29990  },
        2: { name:"Standard",     monthly:4999,  yearly:49990  },
        3: { name:"Professional", monthly:7999,  yearly:79990  },
        4: { name:"Enterprise",   monthly:12999, yearly:129990 }
    };
    const KIOSK_MONTHLY = 2500;
    let selectedPlan = 1, billing = "monthly", pendingCompanyId = null;

    function goStep(n) {
        if (n > 1 && !validateStep(n - 1)) return;
        document.querySelectorAll(".step-content").forEach(el => el.classList.remove("active"));
        document.getElementById("step" + n).classList.add("active");
        [1,2,3,4].forEach(i => {
            const s = document.getElementById("s" + i);
            s.classList.remove("active","done");
            if (i < n) s.classList.add("done");
            else if (i === n) s.classList.add("active");
        });
        window.scrollTo({top:0,behavior:"smooth"});
    }

    function validateStep(n) {
        if (n === 1) {
            if (!document.getElementById("companyName").value.trim()) { alert("Company name is required."); return false; }
            if (!document.getElementById("companyEmail").value.trim()) { alert("Company email is required."); return false; }
        }
        if (n === 2) {
            if (!document.getElementById("adminFirst").value.trim()) { alert("Manager first name is required."); return false; }
            if (!document.getElementById("adminLast").value.trim())  { alert("Manager last name is required."); return false; }
            if (!document.getElementById("adminEmail").value.trim()) { alert("Manager email is required."); return false; }
        }
        return true;
    }

    function selectPlan(level, el) {
        selectedPlan = level;
        document.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
        el.classList.add("selected");
        updateSummary();
    }

    function setBilling(b) {
        billing = b;
        document.getElementById("btnMonthly").className = b === "monthly" ? "btn btn-sm btn-outline-primary active" : "btn btn-sm btn-outline-secondary";
        document.getElementById("btnYearly").innerHTML  = b === "yearly"  ? 'Yearly <span class="badge bg-success ms-1">Save 17%</span>' : 'Yearly <span class="badge bg-success ms-1">Save 17%</span>';
        document.getElementById("btnYearly").className  = b === "yearly"  ? "btn btn-sm btn-outline-primary active" : "btn btn-sm btn-outline-secondary";
        // Update plan prices display
        [1,2,3,4].forEach(i => {
            const p = PLANS[i];
            const el = document.getElementById("p" + i);
            if (el) el.innerHTML = b === "yearly"
                ? `<span style="font-size:.75rem;text-decoration:line-through;opacity:.5;">₱${p.monthly.toLocaleString()}</span> ₱${Math.round(p.yearly/12).toLocaleString()}<span>/mo</span>`
                : `₱${p.monthly.toLocaleString()}<span>/mo</span>`;
        });
        updateSummary();
    }

    function updateSummary() {
        const p = PLANS[selectedPlan];
        const kiosks = parseInt(document.getElementById("kioskCount").value) || 1;
        const planPrice = billing === "yearly" ? p.yearly : p.monthly;
        const kioskCost = kiosks * (billing === "yearly" ? KIOSK_MONTHLY * 12 * 0.83 : KIOSK_MONTHLY);
        const total = planPrice + kioskCost;
        const fmt = v => "₱" + v.toLocaleString("en-PH", {minimumFractionDigits:2});
        document.getElementById("sumPlan").textContent      = `${p.name} — ${billing === "yearly" ? "Yearly" : "Monthly"}`;
        document.getElementById("sumPlanPrice").textContent = fmt(planPrice);
        document.getElementById("sumKiosk").textContent     = fmt(kioskCost);
        document.getElementById("sumTotal").textContent     = fmt(total);
    }

    async function proceedToPayment() {
        if (!validateStep(3)) return;
        const btn = document.getElementById("payBtn");
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating payment link...';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";
        const payload = {
            companyName:    document.getElementById("companyName").value,
            address:        document.getElementById("companyAddress").value,
            contactNumber:  document.getElementById("contactNumber").value,
            adminEmail:     document.getElementById("adminEmail").value,
            adminFirstName: document.getElementById("adminFirst").value,
            adminLastName:  document.getElementById("adminLast").value,
            planLevel:      selectedPlan,
            billingCycle:   billing,
            kioskCount:     parseInt(document.getElementById("kioskCount").value) || 1
        };

        try {
            const r    = await fetch("/Register/Submit", { method:"POST", headers:{"Content-Type":"application/json","RequestVerificationToken":token}, body:JSON.stringify(payload) });
            const data = await r.json();

            if (data.success) {
                pendingCompanyId = data.companyId;
                document.getElementById("payRef").textContent   = data.referenceNo ?? "N/A";
                document.getElementById("payFrame").src         = data.checkoutUrl;
                document.getElementById("confirmPayBtn").dataset.email = payload.adminEmail;
                document.getElementById("confirmPayBtn").dataset.first = payload.adminFirstName;
                document.getElementById("confirmPayBtn").dataset.last  = payload.adminLastName;
                new bootstrap.Modal(document.getElementById("paymentModal")).show();
            } else {
                alert("Error: " + data.message);
            }
        } catch (e) {
            alert("Network error. Please try again.");
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-lock me-2"></i>Proceed to Payment';
    }

    async function confirmPayment() {
        const btn = document.getElementById("confirmPayBtn");
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Confirming...';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";
        const payload = {
            companyId:      pendingCompanyId,
            adminEmail:     btn.dataset.email,
            adminFirstName: btn.dataset.first,
            adminLastName:  btn.dataset.last
        };

        try {
            const r    = await fetch("/Register/ConfirmPayment", { method:"POST", headers:{"Content-Type":"application/json","RequestVerificationToken":token}, body:JSON.stringify(payload) });
            const data = await r.json();

            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById("paymentModal")).hide();
                goStep(4);
            } else {
                alert("Error: " + data.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>I have completed payment';
            }
        } catch (e) {
            alert("Network error. Please try again.");
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>I have completed payment';
        }
    }

    // Init
    updateSummary();
</script>
</body>
</html>
