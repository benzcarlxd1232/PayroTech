@model PayroTech.Models.ViewModels.InitialSetupViewModel
@{
    ViewData["Title"] = "Company Setup";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<style>
    .setup-card { background: var(--pt-bg-card); border: 1px solid var(--pt-border-primary); border-radius: var(--pt-radius-xl); padding: var(--pt-space-6); margin-bottom: var(--pt-space-5); }
    .setup-header { display: flex; align-items: center; gap: var(--pt-space-3); margin-bottom: var(--pt-space-5); padding-bottom: var(--pt-space-3); border-bottom: 2px solid var(--pt-primary-100); }
    .setup-header-icon { width: 44px; height: 44px; border-radius: var(--pt-radius-lg); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: white; background: linear-gradient(135deg, var(--pt-primary-500), var(--pt-primary-600)); flex-shrink: 0; }
    .setup-header h5 { margin: 0; font-weight: 600; color: var(--pt-text-primary); }
    .setup-header p { margin: 0; font-size: 0.85rem; color: var(--pt-text-secondary); }
    .rate-preview { background: var(--pt-primary-50); border: 1px solid var(--pt-primary-200); border-radius: var(--pt-radius-md); padding: var(--pt-space-3) var(--pt-space-4); font-size: 0.85rem; color: var(--pt-primary-700); margin-top: var(--pt-space-2); }
    .step-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--pt-primary-100); color: var(--pt-primary-700); padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; margin-bottom: var(--pt-space-4); }
    .holiday-toggle { display: flex; align-items: center; gap: var(--pt-space-3); padding: var(--pt-space-4); background: var(--pt-bg-secondary); border-radius: var(--pt-radius-lg); border: 1px solid var(--pt-border-primary); }
    .holiday-rate-section { display: none; }
    .holiday-rate-section.visible { display: block; }
    .form-check-input:checked { background-color: var(--pt-primary-500); border-color: var(--pt-primary-500); }
</style>

<div style="max-width: 760px; margin: 0 auto; padding: 0 16px;">

    @* Progress indicator *@
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:40px;height:40px;background:linear-gradient(135deg,var(--pt-primary-500),var(--pt-primary-600));border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">1</div>
        <div style="flex:1;height:3px;background:var(--pt-border-primary);border-radius:2px;">
            <div style="width:50%;height:100%;background:var(--pt-primary-400);border-radius:2px;"></div>
        </div>
        <div style="width:40px;height:40px;background:var(--pt-bg-secondary);border:2px solid var(--pt-border-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--pt-text-secondary);font-weight:700;">2</div>
        <div style="flex:1;height:3px;background:var(--pt-border-primary);border-radius:2px;"></div>
        <div style="width:40px;height:40px;background:var(--pt-bg-secondary);border:2px solid var(--pt-border-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--pt-text-secondary);font-weight:700;">✓</div>
    </div>
    <div class="d-flex justify-content-between mb-5" style="font-size:0.78rem;color:var(--pt-text-secondary);padding:0 4px;">
        <span style="color:var(--pt-primary-600);font-weight:600;">Work Schedule</span>
        <span style="margin-left:auto;margin-right:auto;">Face Photo</span>
        <span>Done</span>
    </div>

    <div class="text-center mb-5">
        <div style="width:64px;height:64px;background:linear-gradient(135deg,#0891b2,#22d3ee);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.8rem;color:#fff;">
            <i class="bi bi-gear-wide-connected"></i>
        </div>
        <h3 class="fw-bold mb-1">Welcome to @Model.CompanyName!</h3>
        <p class="text-muted">Let's configure your company's work schedule and pay rates before you get started.</p>
    </div>

    <form asp-action="InitialSetup" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CompanyId" />
        <input type="hidden" asp-for="CompanyName" />

        @* ── Work Schedule ── *@
        <div class="setup-card">
            <div class="setup-header">
                <div class="setup-header-icon"><i class="bi bi-calendar-week"></i></div>
                <div>
                    <h5>Work Schedule</h5>
                    <p>Set how many days your employees work per week</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Work Days Per Week <span class="text-danger">*</span></label>
                    <div class="d-flex gap-2 flex-wrap">
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded border cursor-pointer workday-option @(Model.WorkDaysPerWeek == 5 ? "border-primary bg-primary bg-opacity-10" : "")" style="cursor:pointer;">
                            <input type="radio" name="WorkDaysPerWeek" value="5" class="form-check-input m-0" @(Model.WorkDaysPerWeek == 5 ? "checked" : "") onchange="updateWorkdays(5)">
                            <span><strong>5 days</strong><br><small class="text-muted">Mon – Fri</small></span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded border cursor-pointer workday-option @(Model.WorkDaysPerWeek == 6 ? "border-primary bg-primary bg-opacity-10" : "")" style="cursor:pointer;">
                            <input type="radio" name="WorkDaysPerWeek" value="6" class="form-check-input m-0" @(Model.WorkDaysPerWeek == 6 ? "checked" : "") onchange="updateWorkdays(6)">
                            <span><strong>6 days</strong><br><small class="text-muted">Mon – Sat</small></span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded border cursor-pointer workday-option @(Model.WorkDaysPerWeek == 7 ? "border-primary bg-primary bg-opacity-10" : "")" style="cursor:pointer;">
                            <input type="radio" name="WorkDaysPerWeek" value="7" class="form-check-input m-0" @(Model.WorkDaysPerWeek == 7 ? "checked" : "") onchange="updateWorkdays(7)">
                            <span><strong>7 days</strong><br><small class="text-muted">Mon – Sun</small></span>
                        </label>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-semibold">Working Days Per Month</label>
                    <input type="number" class="form-control" asp-for="WorkingDaysPerMonth" id="workingDaysPerMonth" min="18" max="31" />
                    <div class="rate-preview" id="workdayPreview">
                        <i class="bi bi-info-circle me-1"></i>
                        Used to compute daily rate from monthly salary.
                    </div>
                </div>
            </div>
        </div>

        @* ── Holiday Pay ── *@
        <div class="setup-card">
            <div class="setup-header">
                <div class="setup-header-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);"><i class="bi bi-calendar-heart"></i></div>
                <div>
                    <h5>Holiday Pay</h5>
                    <p>Configure pay rules when employees work on holidays</p>
                </div>
            </div>

            <div class="holiday-toggle mb-3">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="workOnHolidays"
                           name="WorkOnHolidays" value="true"
                           @(Model.WorkOnHolidays ? "checked" : "")
                           onchange="toggleHolidayRate(this.checked)">
                    <input type="hidden" name="WorkOnHolidays" value="false" />
                </div>
                <div>
                    <strong>Allow work on holidays</strong>
                    <p class="mb-0 text-muted small">Employees may be required to work on public holidays</p>
                </div>
            </div>

            <div class="holiday-rate-section @(Model.WorkOnHolidays ? "visible" : "")" id="holidayRateSection">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Holiday Pay Rate (%)</label>
                        <div class="input-group">
                            <input type="number" class="form-control" asp-for="HolidayPayRate"
                                   id="holidayPayRate" min="100" max="400" step="25"
                                   oninput="updateHolidayPreview()" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="rate-preview" id="holidayPreview">
                            <i class="bi bi-calculator me-1"></i>
                            <span id="holidayPreviewText">@(Model.HolidayPayRate)% = @(Model.HolidayPayRate / 100.0)× daily rate</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-center">
                        <div class="alert alert-warning mb-0 py-2 px-3 small">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Standard:</strong> 200% = double pay (2× daily rate).<br>
                            Philippine Labor Code requires at least 200% for regular holidays.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Overtime ── *@
        <div class="setup-card">
            <div class="setup-header">
                <div class="setup-header-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h5>Overtime Rate</h5>
                    <p>Additional pay multiplier for hours worked beyond regular schedule</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Overtime Rate Multiplier</label>
                    <div class="input-group">
                        <input type="number" class="form-control" asp-for="OvertimeRatePerHour"
                               id="overtimeRate" min="1.00" max="3.00" step="0.05"
                               oninput="updateOvertimePreview()" />
                        <span class="input-group-text">×</span>
                    </div>
                    <div class="rate-preview" id="overtimePreview">
                        <i class="bi bi-calculator me-1"></i>
                        <span id="overtimePreviewText"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="alert alert-info mb-0 py-2 px-3 small">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Standard:</strong> 1.25× = 25% extra per OT hour.<br>
                        Philippine Labor Code minimum is 1.25× for regular OT.
                    </div>
                </div>
            </div>
        </div>

        @* ── Next Step Info ── *@
        <div class="alert alert-primary d-flex align-items-start gap-3 mb-4">
            <i class="bi bi-camera fs-5 mt-1"></i>
            <div>
                <strong>Next: Capture your profile photo</strong><br>
                <span class="small">After saving these settings, you'll take a quick face photo for your ID card and attendance tracking.</span>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="pt-btn pt-btn-primary pt-btn-lg px-5">
                Save & Continue <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function updateWorkdays(days) {
        const monthDays = days === 5 ? 22 : days === 6 ? 26 : 30;
        document.getElementById('workingDaysPerMonth').value = monthDays;
        document.querySelectorAll('.workday-option').forEach(el => {
            el.classList.remove('border-primary', 'bg-primary', 'bg-opacity-10');
        });
        event.currentTarget.closest('.workday-option').classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
    }

    function toggleHolidayRate(checked) {
        const section = document.getElementById('holidayRateSection');
        section.classList.toggle('visible', checked);
    }

    function updateHolidayPreview() {
        const rate = parseFloat(document.getElementById('holidayPayRate').value) || 200;
        const multiplier = (rate / 100).toFixed(2);
        document.getElementById('holidayPreviewText').textContent =
            `${rate}% = ${multiplier}× daily rate`;
    }

    function updateOvertimePreview() {
        const rate = parseFloat(document.getElementById('overtimeRate').value) || 1.25;
        const pct = Math.round((rate - 1) * 100);
        document.getElementById('overtimePreviewText').textContent =
            `${rate}× = regular hourly rate + ${pct}% extra per OT hour`;
    }

    // Init previews on load
    updateHolidayPreview();
    updateOvertimePreview();
</script>
}
