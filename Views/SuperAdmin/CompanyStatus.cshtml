@model List<PayroTech.Models.ViewModels.CompanyListItem>
@{
    ViewData["Title"] = "Company Status";
    Layout = "_SuperAdminLayout";
}

<style>
    body.dark-mode .table-card { background: var(--bg-card) !important; border-color: var(--border-color) !important; }
    body.dark-mode .card-header { background: rgba(0,0,0,0.2) !important; border-color: var(--border-color) !important; color: var(--text-light) !important; }
    body.dark-mode .table { color: var(--text-light) !important; }
    body.dark-mode .table thead th { background: transparent !important; color: var(--text-light) !important; border-color: var(--border-color) !important; }
    body.dark-mode .table tbody td { background: transparent !important; color: var(--text-light) !important; border-color: var(--border-color) !important; }
    body.dark-mode .stats-card { background: var(--bg-card) !important; border-color: var(--border-color) !important; color: var(--text-light) !important; }
    body.dark-mode .stats-card h3, body.dark-mode .stats-card p { color: var(--text-light) !important; }
</style>

<!-- Status Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3>@ViewBag.ActiveCount</h3>
                    <p>Active Companies</p>
                </div>
                <span class="icon"><i class="bi bi-check-circle" style="color:#16a34a;"></i></span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3>@ViewBag.InactiveCount</h3>
                    <p>Inactive / Expired</p>
                </div>
                <span class="icon"><i class="bi bi-x-circle" style="color:#dc2626;"></i></span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3>@ViewBag.ExpiringCount</h3>
                    <p>Expiring in 30 Days</p>
                </div>
                <span class="icon"><i class="bi bi-exclamation-triangle" style="color:#d97706;"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-toggle-on me-2"></i>Company Status Overview</span>
        <span class="text-muted" style="font-size:.82rem;">@Model.Count total companies</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Company Name</th>
                    <th>Employees</th>
                    <th>Subscription Start</th>
                    <th>Subscription End</th>
                    <th>Account</th>
                    <th>Subscription</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No companies registered yet</td></tr>
                }
                @foreach (var company in Model)
                {
                    var daysLeft = company.SubscriptionEnd.HasValue
                        ? (company.SubscriptionEnd.Value - DateTime.UtcNow).Days : 999;
                    var isExpiring = daysLeft <= 30 && daysLeft > 0 && company.IsSubscriptionActive;
                    var isExpired = daysLeft <= 0;

                    <tr>
                        <td><strong>@company.CompanyCode</strong></td>
                        <td>@company.CompanyName</td>
                        <td>@company.EmployeeCount</td>
                        <td>@(company.SubscriptionStart?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>
                            @(company.SubscriptionEnd?.ToString("MMM dd, yyyy") ?? "—")
                            @if (isExpiring)
                            {
                                <br /><small class="text-warning fw-semibold"><i class="bi bi-clock me-1"></i>@daysLeft days left</small>
                            }
                        </td>
                        <td>
                            @if (company.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (isExpired)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else if (isExpiring)
                            {
                                <span class="badge bg-warning text-dark">Expiring</span>
                            }
                            else if (company.IsSubscriptionActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
